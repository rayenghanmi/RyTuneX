<Page
    x:Class="RyTuneX.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <Grid x:Name="ContentArea">
        <ScrollViewer Padding="24,14,24,0">
            <StackPanel Margin="0,0,0,38" Spacing="{StaticResource SettingsCardSpacing}">

                <!-- Network Interface Section -->
                <TextBlock
                    x:Uid="Network_NicSection"
                    Margin="1,6,0,6"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                <controls:SettingsCard x:Uid="Network_NicCard">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE839;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="cmbNetworkInterfaces"
                              MinWidth="200"
                              SelectionChanged="cmbNetworkInterfaces_SelectionChanged"/>
                </controls:SettingsCard>

                <!-- Current DNS Servers Section -->
                <TextBlock
                    x:Uid="Network_CurrentDNSSection"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                <controls:SettingsCard x:Uid="Network_IPv4Card">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE968;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <StackPanel>
                            <TextBlock x:Uid="Network_Primary"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="txtIPv4DNSPrimary" IsReadOnly="True" MinWidth="150"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Uid="Network_Secondary"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="txtIPv4DNSSecondary" IsReadOnly="True" MinWidth="150"/>
                        </StackPanel>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="Network_IPv6Card">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE968;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <StackPanel>
                            <TextBlock x:Uid="Network_Primary"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="txtIPv6DNSPrimary" IsReadOnly="True" MinWidth="150"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Uid="Network_Secondary"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="txtIPv6DNSSecondary" IsReadOnly="True" MinWidth="150"/>
                        </StackPanel>
                    </StackPanel>
                </controls:SettingsCard>

                <!-- Set Custom DNS Section -->
                <TextBlock
                    x:Uid="Network_SetDNSSection"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                <controls:SettingsCard x:Uid="Network_SetDNSCard">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEC27;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="cmbDNSOptions"
                                  ItemsSource="{x:Bind DNSOptions}"
                                  MinWidth="180"/>
                        <Button x:Uid="Network_ApplyDNS" Click="ApplyDNS_Click"/>
                        <Button x:Uid="Network_ResetDNS" Click="ResetDefaultDNS_Click"/>
                    </StackPanel>
                </controls:SettingsCard>

                <!-- Network Tools Section -->
                <TextBlock
                    x:Uid="Network_ToolsSection"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                <controls:SettingsCard x:Uid="Network_FlushDNS">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72C;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="FlushDNSButton"
                                x:Uid="Network_FlushDNS_Button"
                                Click="FlushDNS_Click"/>
                        <ProgressRing x:Name="FlushDNSProgressRing"
                                      Width="20" Height="20"
                                      Visibility="Collapsed"
                                      IsActive="True"/>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="Network_ReleaseRenew">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE895;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ReleaseRenewButton"
                                x:Uid="Network_ReleaseRenew_Button"
                                Click="ReleaseRenewIP_Click"/>
                        <ProgressRing x:Name="ReleaseRenewProgressRing"
                                      Width="20" Height="20"
                                      Visibility="Collapsed"
                                      IsActive="True"/>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="Network_ResetTCPIP">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9F5;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ResetTCPIPButton"
                                x:Uid="Network_ResetTCPIP_Button"
                                Click="ResetTCPIP_Click"/>
                        <ProgressRing x:Name="ResetTCPIPProgressRing"
                                      Width="20" Height="20"
                                      Visibility="Collapsed"
                                      IsActive="True"/>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="Network_OpenNetworkSettings"
                    IsClickEnabled="True"
                    Click="OpenNetworkSettings_Click">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="Network_OpenAdapterSettings"
                    IsClickEnabled="True"
                    Click="OpenAdapterSettings_Click">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE839;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                </controls:SettingsCard>

                <!-- Network Optimization Section -->
                <TextBlock
                    x:Uid="Network_OptimizationSection"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                <controls:SettingsCard x:Uid="Network_DisableThrottling">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEC4A;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="NetworkThrottlingToggle"
                                  Toggled="NetworkThrottlingToggle_Toggled"/>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="Network_DisableNagle">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8E9;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="NagleToggle"
                                  Toggled="NagleToggle_Toggled"/>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="Network_EnableRSS">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="RSSToggle"
                                  Toggled="RSSToggle_Toggled"/>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="Network_EnableECN">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9E9;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="ECNToggle"
                                  Toggled="ECNToggle_Toggled"/>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="Network_EnableCTCP">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xECAD;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="CongestionToggle"
                                  Toggled="CongestionToggle_Toggled"/>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="Network_DisableIPv6">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE703;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="IPv6Toggle"
                                  Toggled="IPv6Toggle_Toggled"/>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="Network_DisableP2PDelivery">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE895;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="P2PDeliveryToggle"
                                  Toggled="P2PDeliveryToggle_Toggled"/>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="Network_DisableHotspot20">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE701;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="Hotspot20Toggle"
                                  Toggled="Hotspot20Toggle_Toggled"/>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="Network_DisableNetBIOS">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE968;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="NetBIOSToggle"
                                  Toggled="NetBIOSToggle_Toggled"/>
                </controls:SettingsCard>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
