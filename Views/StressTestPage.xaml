<Page
    x:Class="RyTuneX.Views.StressTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:RyTuneX.Controls"
    xmlns:behaviors="using:RyTuneX.Behaviors"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    mc:Ignorable="d">

    <ScrollView Padding="24,14,24,24">
        <StackPanel Spacing="24">

            <!-- Page Header -->
            <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                <TextBlock x:Uid="StressTestPage_Title" Text="Stress Test" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Uid="StressTestPage_Description" Text="Push your hardware to its limits and monitor real-time performance under load."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Global Controls -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="StartAllButton" Grid.Column="0" Style="{StaticResource AccentButtonStyle}" Click="StartAll_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,4">
                        <FontIcon Glyph="&#xE768;" FontSize="16"/>
                        <TextBlock x:Uid="StressTestPage_StartAll" Text="Start All"/>
                    </StackPanel>
                </Button>
                <Button x:Name="StopAllButton" Grid.Column="1" Click="StopAll_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,4">
                        <FontIcon Glyph="&#xE71A;" FontSize="16"/>
                        <TextBlock x:Uid="StressTestPage_StopAll" Text="Stop All"/>
                    </StackPanel>
                </Button>

                <!-- Elapsed Time -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE916;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="ElapsedTimeText" Text="00:00:00" FontSize="14" FontWeight="Medium"/>
                </StackPanel>
            </Grid>

            <!-- Summary Cards Row -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Summary -->
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16,12">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE950;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock x:Uid="StressTestPage_CPU" Text="CPU" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="CpuSummaryText" Text="0%" FontSize="24" FontWeight="Bold"/>
                        <TextBlock x:Name="CpuTempText" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- RAM Summary -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16,12">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE964;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock x:Uid="StressTestPage_RAM" Text="RAM" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="RamSummaryText" Text="0%" FontSize="24" FontWeight="Bold"/>
                        <TextBlock x:Name="RamDetailText" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Disk Summary -->
                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16,12">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock x:Uid="StressTestPage_Disk" Text="Disk" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="DiskSummaryText" Text="0 MB/s" FontSize="24" FontWeight="Bold"/>
                        <TextBlock x:Name="DiskDetailText" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- GPU Summary -->
                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16,12">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xF211;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock x:Uid="StressTestPage_GPU" Text="GPU" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="GpuSummaryText" Text="0%" FontSize="24" FontWeight="Bold"/>
                        <TextBlock x:Name="GpuDetailText" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CPU Stress Test Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE950;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel>
                                <TextBlock x:Uid="StressTestPage_CpuStressTest" Text="CPU Stress Test" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock x:Uid="StressTestPage_CpuStressTestDesc" Text="All-core computational load using parallel integer and floating-point workloads"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SelectCoresButton" Click="SelectCoresButton_Click" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE950;" FontSize="14"/>
                                    <TextBlock x:Name="SelectCoresText" x:Uid="StressTestPage_AllCores" Text="All Cores"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CpuStartButton" Click="CpuStart_Click" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="CpuStartIcon" Glyph="&#xE768;" FontSize="14"/>
                                    <TextBlock x:Name="CpuStartText" x:Uid="StressTestPage_Start" Text="Start"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Metrics -->
                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Uid="StressTestPage_Usage" Text="Usage" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="CpuUsageText" Text="0%" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Uid="StressTestPage_Threads" Text="Threads" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="CpuThreadsText" Text="0" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock x:Uid="StressTestPage_Score" Text="Score" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="CpuScoreText" Text="--" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock x:Uid="StressTestPage_Status" Text="Status" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="CpuStatusText" x:Uid="StressTestPage_Idle" Text="Idle" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Graph -->
                    <Grid Grid.Row="2" Height="80" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <local:UsageGraph x:Name="CpuStressGraph" Height="80"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- RAM Stress Test Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE964;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel>
                                <TextBlock x:Uid="StressTestPage_RamStressTest" Text="RAM Stress Test" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock x:Uid="StressTestPage_RamStressTestDesc" Text="Sequential and random memory access patterns to detect stability issues"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="RamPercentCombo" x:Uid="StressTestPage_RamPercentCombo" Width="120" Header="% of RAM" SelectedIndex="0">
                                <ComboBoxItem Content="25%"/>
                                <ComboBoxItem Content="50%"/>
                                <ComboBoxItem Content="75%"/>
                                <ComboBoxItem Content="90%"/>
                            </ComboBox>
                            <Button x:Name="RamStartButton" Click="RamStart_Click" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="RamStartIcon" Glyph="&#xE768;" FontSize="14"/>
                                    <TextBlock x:Name="RamStartText" x:Uid="StressTestPage_Start" Text="Start"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Uid="StressTestPage_Usage" Text="Usage" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="RamUsageText" Text="0%" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Uid="StressTestPage_Allocated" Text="Allocated" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="RamAllocatedText" Text="0 MB" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock x:Uid="StressTestPage_Bandwidth" Text="Bandwidth" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="RamBandwidthText" Text="--" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock x:Uid="StressTestPage_Status" Text="Status" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="RamStatusText" x:Uid="StressTestPage_Idle" Text="Idle" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Height="80" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <local:UsageGraph x:Name="RamStressGraph" Height="80"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Disk Stress Test Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xEDA2;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel>
                                <TextBlock x:Uid="StressTestPage_DiskStressTest" Text="Disk Stress Test" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock x:Uid="StressTestPage_DiskStressTestDesc" Text="Sequential read/write throughput benchmark on the system drive"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="DiskStartButton" Grid.Column="1" Click="DiskStart_Click" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="DiskStartIcon" Glyph="&#xE768;" FontSize="14"/>
                                <TextBlock x:Name="DiskStartText" x:Uid="StressTestPage_Start" Text="Start"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Uid="StressTestPage_WriteSpeed" Text="Write" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="DiskWriteText" Text="0 MB/s" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Uid="StressTestPage_ReadSpeed" Text="Read" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="DiskReadText" Text="0 MB/s" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock x:Uid="StressTestPage_IOPS" Text="IOPS" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="DiskIopsText" Text="--" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock x:Uid="StressTestPage_Status" Text="Status" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="DiskStatusText" x:Uid="StressTestPage_Idle" Text="Idle" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Height="80" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <local:UsageGraph x:Name="DiskStressGraph" Height="80"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- GPU Stress Test Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20" Margin="0,0,0,24">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xF211;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel>
                                <TextBlock x:Uid="StressTestPage_GpuStressTest" Text="GPU Stress Test" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock x:Uid="StressTestPage_GpuStressTestDesc" Text="Hardware-accelerated 3D raymarching fractal &amp; volumetric pipeline to stress GPU up to 100%"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="GpuStartButton" Grid.Column="1" Click="GpuStart_Click" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="GpuStartIcon" Glyph="&#xE768;" FontSize="14"/>
                                <TextBlock x:Name="GpuStartText" x:Uid="StressTestPage_Start" Text="Start"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Uid="StressTestPage_Usage" Text="Usage" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="GpuUsageText" Text="0%" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Uid="StressTestPage_GFLOPS" Text="GFLOPS" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="GpuFpsText" Text="--" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock x:Uid="StressTestPage_VRAM" Text="VRAM" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="GpuVramText" Text="--" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock x:Uid="StressTestPage_Status" Text="Status" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="GpuStatusText" x:Uid="StressTestPage_Idle" Text="Idle" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Height="80" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <local:UsageGraph x:Name="GpuStressGraph" Height="80"/>
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollView>
</Page>
