<Page
    x:Class="RyTuneX.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:RyTuneX.Controls"
    xmlns:behaviors="using:RyTuneX.Behaviors"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingsListItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid"
                              Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background"
                                                    Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background"
                                                    Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollView Padding="24,14,24,24">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header Grid -->
            <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Left" Orientation="Vertical" Margin="24,8,0,16">
                    <TextBlock Text="RyTuneX"
                       FontSize="36"
                       FontWeight="Bold"
                       Margin="0,0,0,4">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{ThemeResource TextFillColorPrimary}" Offset="0"/>
                                <GradientStop Color="{ThemeResource TextFillColorPrimary}" Offset="0.84"/>
                                <GradientStop Color="#FF5E92" Offset="0.84"/>
                                <GradientStop Color="#FF5E92" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>


                    <TextBlock Text="{x:Bind _versionDescription}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                    <Button Style="{StaticResource DefaultButtonStyle}" Click="GithubButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,4">
                            <FontIcon Glyph="&#xE946;" FontSize="16"/>
                            <TextBlock x:Uid="HomePage_MoreInfoButton" Text="More Info"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DefaultButtonStyle}" Click="DiscordButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,4">
                            <BitmapIcon UriSource="ms-appx:///Assets/discord.png" Width="16" Foreground="{ThemeResource TextFillColorPrimary}"/>
                            <TextBlock x:Uid="HomePage_DiscordButton" Text="Join Our Server"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content Grid -->
            <Grid x:Name="ContentGrid" Grid.Row="1" RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Intelligent Score Header -->
                <local:IntelligentScoreHeaderControl x:Name="ScoreHeader" TargetCategory="All" Grid.Row="0"/>

                <!-- System Overview (Row 1) -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Uid="HomePage_SystemOverviewTitle" Text="System Overview" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,16"/>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CPU -->
                        <Grid x:Name="cpuUsage" Grid.Column="0" Height="140" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16">
                            <local:UsageGraph x:Name="cpuGraph" Margin="-16,0,-16,-16" VerticalAlignment="Bottom" Height="70"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="8">
                                <FontIcon Glyph="&#xE950;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Uid="HomePage_cpuUsage" Text="CPU" Style="{StaticResource BodyTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock x:Name="cpuUsageText" Text="0%" VerticalAlignment="Bottom" HorizontalAlignment="Left" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16"/>
                        </Grid>

                        <!-- Memory -->
                        <Grid x:Name="ramUsage" Grid.Column="1" Height="140" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16">
                            <local:UsageGraph x:Name="ramGraph" Margin="-16,0,-16,-16" VerticalAlignment="Bottom" Height="70"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="8">
                                <FontIcon Glyph="&#xE964;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Uid="HomePage_ramUsage" Text="Memory" Style="{StaticResource BodyTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock x:Name="ramUsageText" Text="0%" VerticalAlignment="Bottom" HorizontalAlignment="Left" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16"/>
                        </Grid>

                        <!-- Disk -->
                        <Grid x:Name="diskUsage" Grid.Column="2" Height="140" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16">
                            <local:UsageGraph x:Name="diskGraph" Margin="-16,0,-16,-16" VerticalAlignment="Bottom" Height="70"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="8">
                                <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Uid="HomePage_diskUsage" Text="Disk" Style="{StaticResource BodyTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock x:Name="diskUsageText" Text="0%" VerticalAlignment="Bottom" HorizontalAlignment="Left" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16"/>
                        </Grid>

                        <!-- Network -->
                        <Grid x:Name="networkUsage" Grid.Column="3" Height="140" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16">
                            <local:UsageGraph x:Name="networkDownloadGraph" Margin="-16,0,-16,-16" VerticalAlignment="Bottom" Height="70"/>
                            <local:UsageGraph x:Name="networkUploadGraph" GraphColor="#C8A852" Margin="-16,0,-16,-16" VerticalAlignment="Bottom" Height="70"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="8">
                                <FontIcon Glyph="&#xEDA3;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Uid="HomePage_networkUsage" Text="Network" Style="{StaticResource BodyTextBlockStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" HorizontalAlignment="Left" Spacing="4" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74A;" FontSize="10" Foreground="#C8A852"/>
                                    <TextBlock x:Name="networkUploadUsageText" FontSize="12" Text="0 Mb" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74B;" FontSize="10" Foreground="{ThemeResource SystemAccentColor}"/>
                                    <TextBlock x:Name="networkDownloadUsageText" FontSize="12" Text="0 Mb" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- System and Quick Actions (Row 2) -->
                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- System Section -->
                    <Border Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Uid="HomePage_SystemTitle" Text="System"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Margin="20"/>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- Installed Apps -->
                            <Button Style="{StaticResource SettingsListItemStyle}" Click="InstalledApps_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE71D;" FontSize="16"
                                              Margin="0,0,16,0"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" x:Uid="HomePage_System_InstalledApps"
                                               Text="Installed Apps" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="installedAppsCountText"
                                               Text="..."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="12"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- Processes -->
                            <Button Style="{StaticResource SettingsListItemStyle}" Click="Processes_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xECAA;" FontSize="16"
                                              Margin="0,0,16,0"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" x:Uid="HomePage_System_Processes"
                                               Text="Processes" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="processesCountText"
                                               Text="..."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="12"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- Services -->
                            <Button Style="{StaticResource SettingsListItemStyle}" Click="Services_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE9F5;" FontSize="16"
                                              Margin="0,0,16,0"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" x:Uid="HomePage_System_Services"
                                               Text="Services" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="servicesCountText"
                                               Text="..."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="12"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Quick Actions Section -->
                    <Border Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Uid="HomePage_QuickActionsTitle" Text="Quick Actions"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Margin="20"/>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- Optimize System -->
                            <Button Style="{StaticResource SettingsListItemStyle}" Click="OptimizeSystem_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xF259;" FontSize="16"
                                              Margin="0,0,16,0"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" x:Uid="HomePage_QuickAction_OptimizeSystem"
                                               Text="Optimize System" VerticalAlignment="Center"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- Repair Issues -->
                            <Button Style="{StaticResource SettingsListItemStyle}" Click="RepairIssues_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE90F;" FontSize="16"
                                              Margin="0,0,16,0"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" x:Uid="HomePage_QuickAction_RepairIssues"
                                               Text="Repair Issues" VerticalAlignment="Center"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <!-- Clean Temporary Files -->
                            <Button Style="{StaticResource SettingsListItemStyle}" Click="CleanTemporaryFiles_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE74D;" FontSize="16"
                                              Margin="0,0,16,0"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" x:Uid="HomePage_QuickAction_CleanTemporaryFiles"
                                               Text="Clean Temporary Files" VerticalAlignment="Center"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollView>
</Page>