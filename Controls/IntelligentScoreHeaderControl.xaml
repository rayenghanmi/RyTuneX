<UserControl
    x:Class="RyTuneX.Controls.IntelligentScoreHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:RyTuneX.Models"
    mc:Ignorable="d">

    <StackPanel Spacing="14">
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Width="150" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <Grid HorizontalAlignment="Center">
                        <ProgressRing x:Name="ScoreRing" Value="0" IsIndeterminate="False" Width="92" Height="92"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="ScoreText" Text="--%" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Border x:Name="HealthGradePill" 
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10" 
                                    Padding="7,2" 
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="HealthGradeText" Text="Scanning..." FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ScoreLabelText" Text="Optimization Score" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center" Spacing="8">
                    <controls:WrapPanel Orientation="Horizontal" HorizontalSpacing="8" VerticalSpacing="6">
                        <Border x:Name="DomainBadgeBorder" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="DomainIcon" Glyph="&#xE9F5;" FontSize="12"/>
                                <TextBlock x:Name="DomainTitleText" Text="System Optimizer" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE770;" FontSize="12"/>
                                <TextBlock x:Name="SystemSummaryText" Text="Detecting Hardware..." FontSize="12" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ActiveCountBorder" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                            <TextBlock x:Name="ActiveCountText" Text="Active: 0 / 0" FontSize="12" FontWeight="Medium"/>
                        </Border>

                        <Border x:Name="PotentialGainBorder" Background="{ThemeResource SystemAccentColor}" CornerRadius="4" Padding="8,4" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE78A;" FontSize="12" Foreground="White"/>
                                <TextBlock x:Name="PotentialGainText" Text="Gain: +0 pts" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </controls:WrapPanel>

                    <TextBlock x:Name="StatusMessageText" 
                               Text="Scans, analyzes, previews, applies, verifies, and supports per-item rollback for all optimization settings."
                               FontSize="12" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>

                    <ProgressBar x:Name="MainProgressBar" Value="0" Maximum="100" Visibility="Collapsed" Height="4"/>

                    <Grid x:Name="CategoryMiniScoresGrid" ColumnSpacing="12" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Name="PerfScoreText" Text="Performance: --%" FontSize="10" FontWeight="SemiBold"/>
                            <ProgressBar x:Name="PerfScoreProgress" Value="0" Height="3"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="PrivScoreText" Text="Privacy: --%" FontSize="10" FontWeight="SemiBold"/>
                            <ProgressBar x:Name="PrivScoreProgress" Value="0" Height="3"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock x:Name="FeatScoreText" Text="Usability: --%" FontSize="10" FontWeight="SemiBold"/>
                            <ProgressBar x:Name="FeatScoreProgress" Value="0" Height="3"/>
                        </StackPanel>
                    </Grid>

                    <controls:WrapPanel x:Name="DomainSubMetricsPanel" Orientation="Horizontal" HorizontalSpacing="16" VerticalSpacing="4" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource SystemAccentColor}"/>
                            <TextBlock x:Name="DomainMetric1Text" Text="Recommended: 0" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7A7;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="DomainMetric2Text" Text="Rollbacks Active: 0" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="DomainMetric3Text" Text="Safe / Non-Intrusive" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </controls:WrapPanel>
                </StackPanel>

                <StackPanel x:Name="PageActionPanel" Grid.Column="2" VerticalAlignment="Center" Spacing="6" Width="200">
                    <Grid ColumnSpacing="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="ModeRecommendedBtn" 
                                      Grid.Column="0" 
                                      IsChecked="True" 
                                      Click="ModeButton_Click" 
                                      Tag="Recommended" 
                                      HorizontalAlignment="Stretch" 
                                      Padding="2,5">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" FontSize="10"/>
                                <TextBlock x:Name="ModeRecText" Text="Rec" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ModeAllSafeBtn" 
                                      Grid.Column="1" 
                                      IsChecked="False" 
                                      Click="ModeButton_Click" 
                                      Tag="AllSafe" 
                                      HorizontalAlignment="Stretch" 
                                      Padding="2,5">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE78A;" FontSize="10"/>
                                <TextBlock x:Name="ModeSafeText" Text="Safe" FontSize="10"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ModeAdvancedBtn" 
                                      Grid.Column="2" 
                                      IsChecked="False" 
                                      Click="ModeButton_Click" 
                                      Tag="Advanced" 
                                      HorizontalAlignment="Stretch" 
                                      Padding="2,5">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE7BE;" FontSize="10"/>
                                <TextBlock x:Name="ModeAdvText" Text="Adv" FontSize="10"/>
                            </StackPanel>
                        </ToggleButton>
                    </Grid>

                    <Button x:Name="MainApplyButton" 
                            Click="ApplySelectedMode_Click" 
                            Style="{StaticResource AccentButtonStyle}" 
                            HorizontalAlignment="Stretch" 
                            Padding="10,7">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon x:Name="MainApplyIcon" Glyph="&#xE896;" FontSize="12"/>
                            <TextBlock x:Name="MainApplyBtnText" Text="Apply" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" 
                                Click="Preview_Click" 
                                Style="{StaticResource DefaultButtonStyle}" 
                                HorizontalAlignment="Stretch" 
                                Padding="6,5">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE890;" FontSize="11"/>
                                <TextBlock x:Name="PreviewBtnText" Text="Preview" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" 
                                Click="RollbackPageItems_Click" 
                                Style="{StaticResource DefaultButtonStyle}" 
                                HorizontalAlignment="Stretch" 
                                Padding="6,5">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE7A7;" FontSize="11"/>
                                <TextBlock x:Name="RollbackBtnText" Text="Rollback" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="HomeNavigationPanel" Grid.Column="2" VerticalAlignment="Center" Spacing="6" Width="215" Visibility="Collapsed">
                    <TextBlock x:Name="TuneByDomainHeaderText" Text="Tune By Domain" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,2"/>
                    <StackPanel Spacing="5">
                        <Button Click="NavigateToPerformance_Click" 
                                Style="{StaticResource DefaultButtonStyle}" 
                                HorizontalAlignment="Stretch" 
                                Padding="10,6">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="HomeNavPerfText" Grid.Column="1" Text="Performance" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button Click="NavigateToPrivacy_Click" 
                                Style="{StaticResource DefaultButtonStyle}" 
                                HorizontalAlignment="Stretch" 
                                Padding="10,6">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7B3;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="HomeNavPrivText" Grid.Column="1" Text="Privacy Shield" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button Click="NavigateToFeatures_Click" 
                                Style="{StaticResource DefaultButtonStyle}" 
                                HorizontalAlignment="Stretch" 
                                Padding="10,6">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE74C;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="HomeNavFeatText" Grid.Column="1" Text="Shell Features" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ContentDialog x:Name="PreviewDialog" Title="Intelligent Optimization Preview" PrimaryButtonText="Apply Selected Optimizations" CloseButtonText="Cancel" DefaultButton="Primary">
            <StackPanel Spacing="12" Width="460">
                <TextBlock x:Name="PreviewDialogDescText" Text="Review the proposed optimization changes before applying. Pre-apply rollback points will be automatically saved." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                
                <ScrollViewer MaxHeight="380">
                    <ListView x:Name="PreviewListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:OptimizationItemModel">
                                <Grid Padding="8,6" Margin="0,2" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelectedForApply, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Border Grid.Column="2" Background="{ThemeResource SystemAccentColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{x:Bind RiskDisplay}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>
            </StackPanel>
        </ContentDialog>
    </StackPanel>
</UserControl>
