  <data name="Feature_EnableVerboseLogon.Description" xml:space="preserve">
    <value>Aktivieren Sie detaillierte Anmeldeinformationen für eine bessere Systemüberwachung und Problembehandlung. Nicht unbedingt benutzerfreundlich für den täglichen Gebrauch</value>
  </data>
  <data name="Feature_EnableVerboseLogon.Header" xml:space="preserve">
    <value>Detaillierte Anmeldung aktivieren</value>
  </data>
  <data name="SelecFold" xml:space="preserve">
    <value>Wählen Sie einen Ordner aus</value>
  </data>
