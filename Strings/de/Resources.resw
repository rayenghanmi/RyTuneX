  </data>
  <data name="Feature_DisableHibernation.Header" xml:space="preserve">
    <value>Ruhezustand deaktivieren</value>
  </data>
  <data name="Feature_DisableHibernation.Description" xml:space="preserve">
    <value>Schalten Sie den Ruhezustand aus, um Energie zu sparen und den Computer daran zu hindern, in den Ruhezustand zu gehen. Nicht empfohlen für Laptops</value>
  </data>
  <data name="Feature_DisableHomeGroup.Header" xml:space="preserve">
    <value>Heimnetzgruppe deaktivieren</value>
  </data>
  <data name="Feature_DisableHomeGroup.Description" xml:space="preserve">
    <value>Schaltet die Heimnetzgruppe aus, um das Teilen von Dateien und Druckern mit anderen Geräten im Netzwerk zu stoppen</value>
  </data>
  <data name="Feature_DisablePrintService.Header" xml:space="preserve">
    <value>Druckdienst deaktivieren</value>
  </data>
  <data name="Feature_DisablePrintService.Description" xml:space="preserve">
    <value>Deaktiviert den Druckdienst und verhindert druckbezogene Funktionen</value>
  </data>
  <data name="Feature_DisableCompatibilityAssistant.Header" xml:space="preserve">
    <value>Kompatibilitätsassistent deaktivieren</value>
  </data>
  <data name="Feature_DisableCompatibilityAssistant.Description" xml:space="preserve">
    <value>Schaltet den Kompatibilitätsassistenten aus, um automatische Kompatibilitätsprüfungen für Programme zu deaktivieren</value>
  </data>
  <data name="Feature_DisableSearch.Header" xml:space="preserve">
    <value>Suche deaktivieren</value>
  </data>
  <data name="Feature_DisableSearch.Description" xml:space="preserve">
    <value>Schaltet die systemweite Suchfunktionalität aus</value>
  </data>
  <data name="Feature_DisableErrorReporting.Header" xml:space="preserve">
    <value>Fehlerberichterstattung deaktivieren</value>
  </data>
  <data name="Feature_DisableErrorReporting.Description" xml:space="preserve">
    <value>Schaltet die Fehlerberichterstattung aus, um das automatische Senden von Fehlerberichten an Microsoft zu verhindern</value>
  </data>
  <data name="Feature_DisableGameBar.Header" xml:space="preserve">
    <value>Game Bar deaktivieren</value>
  </data>
  <data name="Feature_DisableGameBar.Description" xml:space="preserve">
    <value>Schaltet die Game Bar und die zugehörigen Funktionen aus</value>
  </data>
  <data name="Feature_DisableQuickAccessHistory.Header" xml:space="preserve">
    <value>Verlauf des Schnellzugriffs deaktivieren</value>
  </data>
  <data name="Feature_DisableQuickAccessHistory.Description" xml:space="preserve">
    <value>Deaktiviert das Aufzeichnen und Anzeigen des Verlaufs des Schnellzugriffs</value>
  </data>
  <data name="Feature_DisableMyPeople.Header" xml:space="preserve">
    <value>Meine Kontakte deaktivieren</value>
  </data>
  <data name="Feature_DisableMyPeople.Description" xml:space="preserve">
    <value>Schaltet die Meine Kontakte-Funktion in der Taskleiste aus</value>
  </data>
  <data name="Feature_DisableWindowsInk.Header" xml:space="preserve">
    <value>Windows Ink deaktivieren</value>
  </data>
  <data name="Feature_DisableWindowsInk.Description" xml:space="preserve">
    <value>Schaltet das Windows Ink Workspace und die zugehörigen Funktionen aus. Nicht empfohlen für Geräte mit einem Stift</value>
  </data>
  <data name="Feature_DisableSpellingAndTypingFeatures.Header" xml:space="preserve">
    <value>Rechtschreib- und Tippfunktionen deaktivieren</value>
  </data>
  <data name="Feature_DisableSpellingAndTypingFeatures.Description" xml:space="preserve">
    <value>Deaktiviert Rechtschreib- und Tippvorschläge</value>
  </data>
  <data name="Feature_DisableFaxService.Header" xml:space="preserve">
    <value>Faxdienst deaktivieren</value>
  </data>
  <data name="Feature_DisableFaxService.Description" xml:space="preserve">
    <value>Deaktiviert den Faxdienst in Windows</value>
  </data>
  <data name="Feature_DisableInsiderService.Header" xml:space="preserve">
    <value>Insider-Dienst deaktivieren</value>
  </data>
  <data name="Feature_DisableInsiderService.Description" xml:space="preserve">
    <value>Austritt aus dem Windows Insider-Programm und Einstellung des Empfangs von Vorabversionen</value>
  </data>
  <data name="Feature_DisableCloudClipboard.Header" xml:space="preserve">
    <value>Cloud-Zwischenablage deaktivieren</value>
  </data>
  <data name="Feature_DisableCloudClipboard.Description" xml:space="preserve">
    <value>Deaktiviert die Cloud-Zwischenablage-Funktion für das Teilen von Zwischenablageinhalten zwischen Geräten</value>
  </data>
  <data name="Feature_DisableStickyKeys.Header" xml:space="preserve">
    <value>Klebe-Tasten deaktivieren</value>
  </data>
  <data name="Feature_DisableStickyKeys.Description" xml:space="preserve">
    <value>Deaktiviert die Klebe-Tasten-Zugänglichkeitsfunktion. Nützlich für Personen, die versehentlich mehrere Tasten gleichzeitig drücken</value>
  </data>
  <data name="Feature_DisableCastToDevice.Header" xml:space="preserve">
    <value>Gerätewiedergabe deaktivieren</value>
  </data>
  <data name="Feature_DisableCastToDevice.Description" xml:space="preserve">
    <value>Deaktiviert die Gerätewiedergabe-Funktion in Windows. Nützlich für Präsentationen oder das Teilen von Medien mit anderen Geräten</value>
  </data>
  <data name="Feature_DisableVBS.Header" xml:space="preserve">
    <value>VBS deaktivieren</value>
  </data>
  <data name="Feature_DisableVBS.Description" xml:space="preserve">
    <value>Deaktiviert Virtualization-Based Security (VBS) für erweiterte Sicherheitsfunktionen. Nicht empfohlen für Umgebungen mit hoher Sicherheitsanforderung</value>
  </data>
  <data name="Feature_MoveTaskbarToLeft.Header" xml:space="preserve">
    <value>Taskleiste nach links verschieben</value>
  </data>
  <data name="Feature_MoveTaskbarToLeft.Description" xml:space="preserve">
    <value>Verschiebt die Taskleiste von der standardmäßigen unteren Position an die linke Bildschirmseite. Persönliche Vorliebe</value>
  </data>
  <data name="Feature_DisableSnapAssist.Header" xml:space="preserve">
    <value>Snap Assist deaktivieren</value>
  </data>
  <data name="Feature_DisableSnapAssist.Description" xml:space="preserve">
    <value>Deaktiviert Snap Assist, welches offene Fenster automatisch anordnet, wenn sie gezogen werden. Nützlich für Multitasking, aber einige Benutzer bevorzugen manuelles Fenstermanagement</value>
  </data>
  <data name="Feature_DisableWidgets.Header" xml:space="preserve">
    <value>Widgets deaktivieren</value>
  </data>
  <data name="Feature_DisableWidgets.Description" xml:space="preserve">
    <value>Deaktiviert die Widgets-Funktion in der Windows 11 Taskleiste. Überlegen Sie, ob Sie die Widgets für schnelle Updates nützlich finden (nur Windows 11)</value>
  </data>
  <data name="Feature_DisableChat.Header" xml:space="preserve">
    <value>Chat deaktivieren</value>
  </data>
  <data name="Feature_DisableChat.Description" xml:space="preserve">
    <value>Deaktiviert die Chat-Funktion in der Windows 11 Taskleiste. Nur empfohlen, wenn Sie die Chat-Funktion nicht für die Kommunikation nutzen (nur Windows 11)</value>
  </data>
  <data name="Feature_EnableFilesCompactMode.Header" xml:space="preserve">
    <value>Kompaktmodus für Dateien aktivieren</value>
  </data>
  <data name="Feature_EnableFilesCompactMode.Description" xml:space="preserve">
    <value>Aktiviert den Kompaktmodus für die Dateiansicht mit kleineren Miniaturansichten. Nützlich für Bildschirme mit geringer Auflösung oder zur Verwaltung großer Ordner</value>
  </data>
  <data name="Feature_DisableStickers.Header" xml:space="preserve">
    <value>Sticker deaktivieren</value>
  </data>
  <data name="Feature_DisableStickers.Description" xml:space="preserve">
    <value>Deaktiviert die Sticker-Funktion in der Windows 11 Nachrichten-App. Nur empfohlen, wenn Sie Sticker nicht für die Kommunikation nutzen (nur Windows 11)</value>
  </data>
  <data name="Feature_DisableEdgeDiscoverBar.Header" xml:space="preserve">
    <value>Edge Discover Bar deaktivieren</value>
  </data>
  <data name="Feature_DisableEdgeDiscoverBar.Description" xml:space="preserve">
    <value>Deaktiviert die Discover Bar-Funktion in Microsoft Edge. Nützlich, wenn Sie diese als störend empfinden oder eine übersichtlichere Browseroberfläche bevorzugen</value>
  </data>
  <data name="Feature_DisableCoPilotAI.Header" xml:space="preserve">
    <value>CoPilot AI deaktivieren</value>
  </data>
  <data name="Feature_DisableCoPilotAI.Description" xml:space="preserve">
    <value>Deaktiviert die CoPilot AI Funktion in Windows zur Unterstützung bei der Code-Schreibung. Nicht empfohlen für Entwickler</value>
  </data>
  <data name="Feature_DisableSysMain.Header" xml:space="preserve">
    <value>SysMain deaktivieren</value>
  </data>
  <data name="Feature_DisableSysMain.Description" xml:space="preserve">
    <value>Deaktiviert SysMain, welches häufig genutzte Anwendungen für einen schnelleren Start vorlädt. Kann die Startzeiten einiger Programme beeinflussen, wenn HDD verwendet wird.</value>
  </data>
  <data name="Feature_EnableGamingMode.Header" xml:space="preserve">
    <value>Gaming-Modus aktivieren</value>
  </data>
  <data name="Feature_EnableGamingMode.Description" xml:space="preserve">
    <value>Aktiviert den Gaming-Modus, welcher Systemressourcen für ein flüssigeres Spielerlebnis optimiert. Kann Hintergrundprozesse beeinflussen.</value>
  </data>
  <data name="Feature_EnableFullscreenOptimizations.Header" xml:space="preserve">
    <value>Vollbildoptimierungen aktivieren</value>
  </data>
  <data name="Feature_EnableFullscreenOptimizations.Description" xml:space="preserve">
    <value>Ermöglicht Windows, den Vollbildoptimierungspfad für Spiele zu verwenden. Deaktiviere diese Option nur bei Spielen, die exklusiven Vollbildmodus benötigen.</value>
  </data>
  <data name="Feature_GpuDriverTweaks.Header" xml:space="preserve">
    <value>Leistungsoptimierungen für GPU-Treiber</value>
  </data>
  <data name="Feature_GpuDriverTweaks.Description" xml:space="preserve">
    <value>Wendet Registry-Optimierungen für AMD-, NVIDIA- und Intel-Grafikkarten an, um das Umschalten der GPU-Energiezustände und die Anzeigelatenz zu reduzieren.</value>
  </data>
  <data name="Feature_ExcludeDriversFromWindowsUpdates.Header" xml:space="preserve">
    <value>Treiber von Windows-Updates ausschließen</value>
  </data>
  <data name="Feature_ExcludeDriversFromWindowsUpdates.Description" xml:space="preserve">
    <value>Schließt Treiberupdates von Windows Update aus. Kann zu veralteten Treibern mit potenziellen Sicherheitsrisiken oder Kompatibilitätsproblemen führen. Mit Vorsicht verwenden.</value>
  </data>
  <data name="Feature_DisableSystemRestore.Header" xml:space="preserve">
    <value>Systemwiederherstellung deaktivieren</value>
  </data>
  <data name="Feature_DisableSystemRestore.Description" xml:space="preserve">
    <value>Deaktiviert die Systemwiederherstellung, die Wiederherstellungspunkte erstellt, um das System bei Problemen auf einen früheren Zustand zurückzusetzen. Nicht empfohlen. Das Deaktivieren dieser Funktion entfernt die Möglichkeit, einfach von potenziellen Systemproblemen wiederherzustellen.</value>
  </data>
  <data name="Feature_DisableCortana.Header" xml:space="preserve">
    <value>Cortana deaktivieren</value>
  </data>
  <data name="Feature_DisableCortana.Description" xml:space="preserve">
    <value>Deaktiviert Cortana, den virtuellen Assistenten, der Fragen beantworten und Aufgaben erledigen kann. Kann die Sprachsuche und einige Produktivitätsfunktionen beeinflussen.</value>
  </data>
  <data name="Feature_DisableStoreUpdates.Header" xml:space="preserve">
    <value>Store-Updates deaktivieren</value>
  </data>
  <data name="Feature_DisableStoreUpdates.Description" xml:space="preserve">
    <value>Deaktiviert automatische Updates für Apps, die aus dem Microsoft Store heruntergeladen wurden. Kann Apps anfällig für Sicherheitsrisiken machen oder ohne neue Funktionen lassen.</value>
  </data>
  <data name="Feature_DisableSMBv1.Header" xml:space="preserve">
    <value>SMBv1 deaktivieren</value>
  </data>
  <data name="Feature_DisableSMBv1.Description" xml:space="preserve">
    <value>Deaktiviert Server Message Block Version 1 (SMBv1) für verbesserte Sicherheit. Empfohlen</value>
  </data>
  <data name="Feature_DisableSMBv2.Header" xml:space="preserve">
    <value>SMBv2 deaktivieren</value>
  </data>
  <data name="Feature_DisableSMBv2.Description" xml:space="preserve">
    <value>Deaktiviert Server Message Block Version 2 (SMBv2) für verbesserte Sicherheit. Mit Vorsicht verwenden, da dies die Funktionalität der Netzwerkdateifreigabe beeinträchtigen könnte.</value>
  </data>
  <data name="Feature_DisableTelemetryServices.Header" xml:space="preserve">
