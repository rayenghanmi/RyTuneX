  </data>
  <data name="Network_DisableHotspot20.Description" xml:space="preserve">
    <value>Deaktiviert die automatische Erkennung und Verbindung mit Hotspot 2.0 (Passpoint)-WLAN-Netzwerken für verbesserten Datenschutz.</value>
  </data>
  <data name="Network_DisableNetBIOS.Header" xml:space="preserve">
