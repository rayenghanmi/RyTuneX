  </data>
  <data name="Feature_DisableTelemetryServices.Description" xml:space="preserve">
    <value>Deaktiviert Telemetriedienste, um die Sammlung und Übermittlung von Nutzungsdaten durch das Betriebssystem zu verhindern.</value>
  </data>
  <data name="Feature_DisableEdgeTelemetry.Header" xml:space="preserve">
