  <data name="Feature_DisableSMBv2.Description" xml:space="preserve">
    <value>Disabilita Server Message Block versione 2 (SMBv2) per una maggiore sicurezza. Usare con cautela in quanto potrebbe interrompere le funzionalità di condivisione dei file di rete.</value>
  </data>
  <data name="Feature_DisableTelemetryServices.Header" xml:space="preserve">
