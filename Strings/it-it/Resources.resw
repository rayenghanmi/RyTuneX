  <data name="Feature_DisableHibernation.Header" xml:space="preserve">
    <value>Disattiva ibernazione</value>
  </data>
  <data name="Feature_DisableHibernation.Description" xml:space="preserve">
    <value>Disattiva la modalità di sospensione per risparmiare energia ed evitare che il computer entri in modalità di sospensione. Non consigliato per i laptop</value>
  </data>
  <data name="Feature_DisableHomeGroup.Header" xml:space="preserve">
    <value>Disabilita Gruppo Home</value>
  </data>
  <data name="Feature_DisableHomeGroup.Description" xml:space="preserve">
    <value>Disabilita Gruppo Home per interrompere la condivisione di file e stampanti con altri dispositivi sulla rete</value>
  </data>
  <data name="Feature_DisablePrintService.Header" xml:space="preserve">
    <value>Disabilita Servizio di stampa</value>
  </data>
  <data name="Feature_DisablePrintService.Description" xml:space="preserve">
    <value>Disabilita il servizio di stampa, impedendo le funzionalità correlate alla stampa</value>
  </data>
  <data name="Feature_DisableCompatibilityAssistant.Header" xml:space="preserve">
    <value>Disabilita Compatibilità Assistente</value>
  </data>
  <data name="Feature_DisableCompatibilityAssistant.Description" xml:space="preserve">
    <value>Disattiva Assistente compatibilità per disabilitare i controlli di compatibilità automatici per i programmi</value>
  </data>
  <data name="Feature_DisableSearch.Header" xml:space="preserve">
    <value>Disattiva ricerca</value>
  </data>
  <data name="Feature_DisableSearch.Description" xml:space="preserve">
    <value>Disattiva Assistente compatibilità per disabilitare i controlli di compatibilità automatici per i programmi ...funzionalità di ricerca stem-wide</value>
  </data>
  <data name="Feature_DisableErrorReporting.Header" xml:space="preserve">
    <value>Disabilita segnalazione errori</value>
  </data>
  <data name="Feature_DisableErrorReporting.Description" xml:space="preserve">
    <value>Disabilita segnalazione errori per impedire l'invio automatico di segnalazioni errori a Microsoft</value>
  </data>
  <data name="Feature_DisableGameBar.Header" xml:space="preserve">
    <value>Disabilita Game Bar</value>
  </data>
  <data name="Feature_DisableGameBar.Description" xml:space="preserve">
    <value>Disabilita Game Bar e le sue funzionalità associate</value>
  </data>
  <data name="Feature_DisableQuickAccessHistory.Header" xml:space="preserve">
    <value>Disabilita Cronologia di accesso rapido</value>
  </data>
  <data name="Feature_DisableQuickAccessHistory.Description" xml:space="preserve">
    <value>Disabilita la registrazione e la visualizzazione della cronologia di accesso rapido</value>
  </data>
  <data name="Feature_DisableMyPeople.Header" xml:space="preserve">
    <value>Disabilita Le mie persone</value>
  </data>
  <data name="Feature_DisableMyPeople.Description" xml:space="preserve">
    <value>Disattiva la funzionalità Le mie persone nella barra delle applicazioni</value>
  </data>
  <data name="Feature_DisableWindowsInk.Header" xml:space="preserve">
    <value>Disattiva Windows Ink</value>
  </data>
  <data name="Feature_DisableWindowsInk.Description" xml:space="preserve">
    <value>Disattiva Windows Ink Workspace e le funzionalità correlate. Non consigliato per dispositivi con stilo</value>
  </data>
  <data name="Feature_DisableSpellingAndTypingFeatures.Header" xml:space="preserve">
    <value>Disabilita le funzionalità di ortografia e digitazione</value>
  </data>
  <data name="Feature_DisableSpellingAndTypingFeatures.Description" xml:space="preserve">
    <value>Disabilita i suggerimenti di ortografia e digitazione</value>
  </data>
  <data name="Feature_DisableFaxService.Header" xml:space="preserve">
    <value>Disabilita il servizio fax</value>
  </data>
  <data name="Feature_DisableFaxService.Description" xml:space="preserve">
    <value>Disabilita il servizio fax in Windows</value>
  </data>
  <data name="Feature_DisableInsiderService.Header" xml:space="preserve">
    <value>Disabilita Insider Service</value>
  </data>
  <data name="Feature_DisableInsiderService.Description" xml:space="preserve">
    <value>Disattiva il programma Windows Insider e interrompi la ricezione di build di anteprima</value>
  </data>
  <data name="Feature_DisableCloudClipboard.Header" xml:space="preserve">
    <value>Disabilita Cloud Clipboard</value>
  </data>
  <data name="Feature_DisableCloudClipboard.Description" xml:space="preserve">
    <value>Disabilita la funzionalità Cloud Clipboard per la condivisione degli appunti tra dispositivi</value>
  </data>
  <data name="Feature_DisableStickyKeys.Header" xml:space="preserve">
    <value>Disabilita tasti permanenti</value>
  </data>
  <data name="Feature_DisableStickyKeys.Description" xml:space="preserve">
    <value>Disabilita la funzionalità di accessibilità Tasti permanenti. Utile per le persone che premono accidentalmente più tasti contemporaneamente</value>
  </data>
  <data name="Feature_DisableCastToDevice.Header" xml:space="preserve">
    <value>Disabilita Cast to Device</value>
  </data>
  <data name="Feature_DisableCastToDevice.Description" xml:space="preserve">
    <value>Disabilita la funzionalità Cast to Device in Windows. Utile per presentazioni o condivisione di contenuti multimediali su altri dispositivi</value>
  </data>
  <data name="Feature_DisableVBS.Header" xml:space="preserve">
    <value>Disabilita VBS</value>
  </data>
  <data name="Feature_DisableVBS.Description" xml:space="preserve">
    <value>Disabilita Virtualization-Based Security (VBS) per funzionalità di sicurezza avanzate. Non consigliato per ambienti ad alta sicurezza</value>
  </data>
  <data name="Feature_MoveTaskbarToLeft.Header" xml:space="preserve">
    <value>Sposta la barra delle applicazioni a sinistra</value>
  </data>
  <data name="Feature_MoveTaskbarToLeft.Description" xml:space="preserve">
    <value>Sposta la barra delle applicazioni dalla posizione predefinita in basso al lato sinistro dello schermo. Preferenza personale</value>
  </data>
  <data name="Feature_DisableSnapAssist.Header" xml:space="preserve">
    <value>Disabilita Snap Assist</value>
  </data>
  <data name="Feature_DisableSnapAssist.Description" xml:space="preserve">
    <value>Disabilita Snap Assist, che dispone automaticamente le finestre aperte durante il trascinamento. Utile per il multitasking, ma alcuni utenti preferiscono la gestione manuale delle finestre</value>
  </data>
  <data name="Feature_DisableWidgets.Header" xml:space="preserve">
    <value>Disabilita i widget</value>
  </data>
  <data name="Feature_DisableWidgets.Description" xml:space="preserve">
    <value>Disabilita la funzionalità Widget sulla barra delle applicazioni di Windows 11. Considera setrovi i widget utili per aggiornamenti rapidi (solo Windows 11)</value>
  </data>
  <data name="Feature_DisableChat.Header" xml:space="preserve">
    <value>Disabilita Chat</value>
  </data>
  <data name="Feature_DisableChat.Description" xml:space="preserve">
    <value>Disabilita la funzionalità Chat sulla barra delle applicazioni di Windows 11. Consigliato solo se non utilizzi la funzionalità Chat per la comunicazione (solo Windows 11)</value>
  </data>
  <data name="Feature_EnableFilesCompactMode.Header" xml:space="preserve">
    <value>Abilita la modalità compatta dei file</value>
  </data>
  <data name="Feature_EnableFilesCompactMode.Description" xml:space="preserve">
    <value>Abilita la modalità compatta per l'esplorazione dei file con miniature più piccole. Utile per schermi a bassa risoluzione o per la gestione di cartelle di grandi dimensioni</value>
  </data>
  <data name="Feature_DisableStickers.Header" xml:space="preserve">
    <value>Disabilita adesivi</value>
  </data>
  <data name="Feature_DisableStickers.Description" xml:space="preserve">
    <value>Disabilita la funzionalità Adesivi nell'app di messaggistica di Windows 11. Consigliato solo se non utilizzi adesivi per la comunicazione (solo Windows 11)</value>
  </data>
  <data name="Feature_DisableEdgeDiscoverBar.Header" xml:space="preserve">
    <value>Disabilita Edge Discover Bar</value>
  </data>
  <data name="Feature_DisableEdgeDiscoverBar.Description" xml:space="preserve">
    <value>Disabilita la funzionalità Discover Bar in Microsoft Edge. Utile se lo trovi distraente o preferisci un'interfaccia del browser più pulita</value>
  </data>
  <data name="Feature_DisableCoPilotAI.Header" xml:space="preserve">
    <value>Disabilita CoPilot AI</value>
  </data>
  <data name="Feature_DisableCoPilotAI.Description" xml:space="preserve">
    <value>Disabilita la funzionalità CoPilot AI in Windows per assistenza nella scrittura del codice. Non consigliato per gli sviluppatori</value>
  </data>
  <data name="OptimizeBasic.Text" xml:space="preserve">
    <value>Ottimizzazioni di base</value>
  </data>
  <data name="Feature_PerformanceTweaks.Header" xml:space="preserve">
    <value>Modifiche delle prestazioni</value>
  </data>
  <data name="Feature_DisableSysMain.Header" xml:space="preserve">
    <value>Disabilita SysMain</value>
  </data>
  <data name="Feature_DisableSysMain.Description" xml:space="preserve">
    <value>Disattiva SysMain, che precarica le applicazioni utilizzate di frequente per un avvio più rapido. Potrebbe influire sui tempi di avvio di alcuni programmi se si utilizza un HDD.</value>
  </data>
  <data name="Feature_EnableGamingMode.Header" xml:space="preserve">
    <value>Abilita modalità di gioco</value>
  </data>
  <data name="Feature_EnableGamingMode.Description" xml:space="preserve">
    <value>Abilita la modalità di gioco, che ottimizza le risorse di sistema per un'esperienza di gioco più fluida. Potrebbe influire sui processi in background.</value>
  </data>
  <data name="Feature_EnableFullscreenOptimizations.Header" xml:space="preserve">
    <value>Attiva le ottimizzazioni a schermo intero</value>
  </data>
  <data name="Feature_EnableFullscreenOptimizations.Description" xml:space="preserve">
    <value>Consente a Windows di utilizzare il percorso di ottimizzazione a schermo intero per i giochi. Disattiva questa opzione solo per i giochi che richiedono la modalità a schermo intero esclusiva.</value>
  </data>
  <data name="Feature_GpuDriverTweaks.Header" xml:space="preserve">
    <value>Ottimizzazioni delle prestazioni del driver GPU</value>
  </data>
  <data name="Feature_GpuDriverTweaks.Description" xml:space="preserve">
    <value>Applica modifiche al registro per GPU AMD, NVIDIA e Intel per ridurre i cambi di stato energetico della GPU e la latenza del display.</value>
  </data>
  <data name="Feature_ExcludeDriversFromWindowsUpdates.Header" xml:space="preserve">
    <value>Escludi driver da Windows Update</value>
  </data>
  <data name="Feature_ExcludeDriversFromWindowsUpdates.Description" xml:space="preserve">
    <value>Esclude gli aggiornamenti dei driver da Windows Update. Potrebbe causare driver obsoleti con potenziali rischi per la sicurezza o problemi di compatibilità. Usare con cautela.</value>
  </data>
  <data name="OptimizeAdvanced.Text" xml:space="preserve">
    <value>Ottimizzazioni avanzate</value>
  </data>
  <data name="Feature_DisableSystemRestore.Header" xml:space="preserve">
    <value>Disabilita Ripristino configurazione di sistema</value>
  </data>
  <data name="Feature_DisableSystemRestore.Description" xml:space="preserve">
    <value>Disabilita Ripristino configurazione di sistema, che crea punti di ripristino per riportare il sistema a uno stato precedente in caso di problemi. Non consigliato. La disattivazione di questa funzionalità rimuove la possibilità di ripristinare facilmente potenziali problemi di sistema.</value>
  </data>
  <data name="Feature_DisableCortana.Header" xml:space="preserve">
    <value>Disattiva Cortana</value>
  </data>
  <data name="Feature_DisableCortana.Description" xml:space="preserve">
    <value>Disattiva Cortana, l'assistente virtuale che può rispondere alle domande e completare le attività. Potrebbe influire sulla ricerca vocale e su alcune funzionalità di produttività.</value>
  </data>
  <data name="Feature_DisableStoreUpdates.Header" xml:space="preserve">
    <value>Disattiva gli aggiornamenti dello Store</value>
  </data>
  <data name="Feature_DisableStoreUpdates.Description" xml:space="preserve">
    <value>Disattiva gli aggiornamenti automatici per le app scaricate da Microsoft Store. Potrebbe lasciare le app vulnerabili a rischi per la sicurezza o prive di nuove funzionalità.</value>
  </data>
