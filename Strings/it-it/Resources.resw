  <data name="Feature_EnableVerboseLogon.Description" xml:space="preserve">
    <value>Abilita messaggi di accesso dettagliati per un migliore monitoraggio e risoluzione dei problemi del sistema. Potrebbe non essere intuitivo per l'uso quotidiano</value>
