  <data name="Feature_EnableVerboseLogon.Description" xml:space="preserve">
    <value>Habilite mensagens de logon detalhadas para melhor monitoramento e solução de problemas do sistema. Pode não ser fácil de usar para uso diário</value>
  </data>
  <data name="Feature_EnableVerboseLogon.Header" xml:space="preserve">
    <value>Habilitar logon detalhado</value>
  </data>
