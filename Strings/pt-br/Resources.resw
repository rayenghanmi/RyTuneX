  <data name="Feature_DisableHibernation.Header" xml:space="preserve">
    <value>Desativar Hibernação</value>
  </data>
  <data name="Feature_DisableHibernation.Description" xml:space="preserve">
    <value>Desative a hibernação para economizar energia e evitar que o computador entre no modo de suspensão. Não recomendado para laptops</value>
  </data>
  <data name="Feature_DisableHomeGroup.Header" xml:space="preserve">
    <value>Desabilitar Grupo Doméstico</value>
  </data>
  <data name="Feature_DisableHomeGroup.Description" xml:space="preserve">
    <value>Desativa o Grupo Doméstico para parar de compartilhar arquivos e impressoras com outros dispositivos na rede</value>
  </data>
  <data name="Feature_DisablePrintService.Header" xml:space="preserve">
    <value>Desabilitar Serviço de Impressão</value>
  </data>
  <data name="Feature_DisablePrintService.Description" xml:space="preserve">
    <value>Desabilita o serviço de impressão, impedindo funcionalidades relacionadas à impressão</value>
  </data>
  <data name="Feature_DisableCompatibilityAssistant.Header" xml:space="preserve">
    <value>Desabilitar Assistente de Compatibilidade</value>
  </data>
  <data name="Feature_DisableCompatibilityAssistant.Description" xml:space="preserve">
    <value>Desativa o Assistente de Compatibilidade para desabilitar verificações automáticas de compatibilidade para programas</value>
  </data>
  <data name="Feature_DisableSearch.Header" xml:space="preserve">
    <value>Desativar Pesquisa</value>
  </data>
  <data name="Feature_DisableSearch.Description" xml:space="preserve">
    <value>Desativa o syfuncionalidade de pesquisa em todo o tronco</value>
  </data>
  <data name="Feature_DisableErrorReporting.Header" xml:space="preserve">
    <value>Desabilitar Relatório de Erros</value>
  </data>
  <data name="Feature_DisableErrorReporting.Description" xml:space="preserve">
    <value>Desativa o relatório de erros para impedir o envio automático de relatórios de erros para a Microsoft</value>
  </data>
  <data name="Feature_DisableGameBar.Header" xml:space="preserve">
    <value>Desabilitar Barra de Jogos</value>
  </data>
  <data name="Feature_DisableGameBar.Description" xml:space="preserve">
    <value>Desativa a Barra de Jogos e seus recursos associados</value>
  </data>
  <data name="Feature_DisableQuickAccessHistory.Header" xml:space="preserve">
    <value>Desabilitar Histórico de Acesso Rápido</value>
  </data>
  <data name="Feature_DisableQuickAccessHistory.Description" xml:space="preserve">
    <value>Desabilita a gravação e a exibição do histórico de acesso rápido</value>
  </data>
  <data name="Feature_DisableMyPeople.Header" xml:space="preserve">
    <value>Desabilitar Minhas Pessoas</value>
  </data>
  <data name="Feature_DisableMyPeople.Description" xml:space="preserve">
    <value>Desativa o recurso Minhas Pessoas na barra de tarefas</value>
  </data>
  <data name="Feature_DisableWindowsInk.Header" xml:space="preserve">
    <value>Desativar Windows Ink</value>
  </data>
  <data name="Feature_DisableWindowsInk.Description" xml:space="preserve">
    <value>Desativa o Windows Ink Workspace e recursos relacionados. Não recomendado para dispositivos com caneta</value>
  </data>
  <data name="Feature_DisableSpellingAndTypingFeatures.Header" xml:space="preserve">
    <value>Desabilitar recursos de ortografia e digitação</value>
  </data>
  <data name="Feature_DisableSpellingAndTypingFeatures.Description" xml:space="preserve">
    <value>Desabilita sugestões de ortografia e digitação</value>
  </data>
  <data name="Feature_DisableFaxService.Header" xml:space="preserve">
    <value>Desabilitar serviço de fax</value>
  </data>
  <data name="Feature_DisableFaxService.Description" xml:space="preserve">
    <value>Desabilita o serviço de fax no Windows</value>
  </data>
  <data name="Feature_DisableInsiderService.Header" xml:space="preserve">
    <value>Desabilitar o Insider Serviço</value>
  </data>
  <data name="Feature_DisableInsiderService.Description" xml:space="preserve">
    <value>Desativar o Programa Windows Insider e parar de receber compilações de visualização</value>
  </data>
  <data name="Feature_DisableCloudClipboard.Header" xml:space="preserve">
    <value>Desativar a Área de Transferência na Nuvem</value>
  </data>
  <data name="Feature_DisableCloudClipboard.Description" xml:space="preserve">
    <value>Desativa o recurso Área de Transferência na Nuvem para compartilhamento de área de transferência entre dispositivos</value>
  </data>
  <data name="Feature_DisableStickyKeys.Header" xml:space="preserve">
    <value>Desativar Teclas de Aderência</value>
  </data>
  <data name="Feature_DisableStickyKeys.Description" xml:space="preserve">
    <value>Desativa o recurso de acessibilidade Teclas de Aderência. Útil para pessoas que acidentalmente pressionam várias teclas ao mesmo tempo</value>
  </data>
  <data name="Feature_DisableCastToDevice.Header" xml:space="preserve">
    <value>Desabilitar transmissão para dispositivo</value>
  </data>
  <data name="Feature_DisableCastToDevice.Description" xml:space="preserve">
    <value>Desabilita o recurso Transmitir para dispositivo no Windows. Útil para apresentações ou compartilhamento de mídia em outros dispositivos</value>
  </data>
  <data name="Feature_DisableVBS.Header" xml:space="preserve">
    <value>Desabilitar VBS</value>
  </data>
  <data name="Feature_DisableVBS.Description" xml:space="preserve">
    <value>Desabilita a Segurança Baseada em Virtualização (VBS) para recursos de segurança avançados. Não recomendado para ambientes de alta segurança</value>
  </data>
  <data name="Feature_MoveTaskbarToLeft.Header" xml:space="preserve">
    <value>Mover barra de tarefas para a esquerda</value>
  </data>
  <data name="Feature_MoveTaskbarToLeft.Description" xml:space="preserve">
    <value>Move a barra de tarefas da posição inferior padrão para o lado esquerdo da tela. Preferência pessoal</value>
  </data>
  <data name="Feature_DisableSnapAssist.Header" xml:space="preserve">
    <value>Desativar Snap Assist</value>
  </data>
  <data name="Feature_DisableSnapAssist.Description" xml:space="preserve">
    <value>Desativa o Snap Assist, que organiza automaticamente as janelas abertas ao arrastar. Útil para multitarefa, mas alguns usuários preferem o gerenciamento manual de janelas</value>
  </data>
  <data name="Feature_DisableWidgets.Header" xml:space="preserve">
    <value>Desabilitar Widgets</value>
  </data>
  <data name="Feature_DisableWidgets.Description" xml:space="preserve">
    <value>Desabilita o recurso Widgets na barra de tarefas do Windows 11. Considere se vocêvocê acha os widgets úteis para atualizações rápidas (somente Windows 11)</value>
  </data>
  <data name="Feature_DisableChat.Header" xml:space="preserve">
    <value>Desabilitar Chat</value>
  </data>
  <data name="Feature_DisableChat.Description" xml:space="preserve">
    <value>Desabilita o recurso Chat na barra de tarefas do Windows 11. Recomendado somente se você não usar o recurso chat para comunicação (somente Windows 11)</value>
  </data>
  <data name="Feature_EnableFilesCompactMode.Header" xml:space="preserve">
    <value>Habilitar Modo Compacto de Arquivos</value>
  </data>
  <data name="Feature_EnableFilesCompactMode.Description" xml:space="preserve">
    <value>Habilita o Modo Compacto para navegação de arquivos com miniaturas menores. Útil para telas de baixa resolução ou gerenciamento de pastas grandes</value>
  </data>
  <data name="Feature_DisableStickers.Header" xml:space="preserve">
    <value>Desabilitar adesivos</value>
  </data>
  <data name="Feature_DisableStickers.Description" xml:space="preserve">
    <value>Desabilita o recurso Adesivos no aplicativo de mensagens do Windows 11. Recomendado somente se você não usar adesivos para comunicação (somente Windows 11)</value>
  </data>
  <data name="Feature_DisableEdgeDiscoverBar.Header" xml:space="preserve">
    <value>Desabilitar Barra de Descoberta do Edge</value>
  </data>
  <data name="Feature_DisableEdgeDiscoverBar.Description" xml:space="preserve">
    <value>Desabilita o recurso Barra de Descoberta no Microsoft Edge. Útil se você achar que ele distrai ou preferir uma interface de navegador mais limpa</value>
  </data>
  <data name="Feature_DisableCoPilotAI.Header" xml:space="preserve">
    <value>Desabilitar CoPilot AI</value>
  </data>
  <data name="Feature_DisableCoPilotAI.Description" xml:space="preserve">
    <value>Desabilita o recurso CoPilot AI no Windows para assistência na escrita de código. Não recomendado para desenvolvedores</value>
  </data>
  <data name="Feature_DisableSysMain.Header" xml:space="preserve">
    <value>Desabilitar SysMain</value>
  </data>
  <data name="Feature_DisableSysMain.Description" xml:space="preserve">
    <value>Desativa o SysMain, que pré-carrega aplicativos usados ​​com frequência para inicialização mais rápida. Pode afetar os tempos de inicialização de alguns programas se você estiver usando HDD.</value>
  </data>
  <data name="Feature_EnableGamingMode.Header" xml:space="preserve">
    <value>Habilitar modo de jogo</value>
  </data>
  <data name="Feature_EnableGamingMode.Description" xml:space="preserve">
    <value>Habilita o modo de jogo, que otimiza os recursos do sistema para uma experiência de jogo mais suave. Pode afetar processos em segundo plano.</value>
  </data>
  <data name="Feature_EnableFullscreenOptimizations.Header" xml:space="preserve">
    <value>Ativar otimizações de tela inteira</value>
  </data>
  <data name="Feature_EnableFullscreenOptimizations.Description" xml:space="preserve">
    <value>Permite que o Windows use a otimização de tela inteira para jogos. Desative esta opção apenas para jogos que exigem o modo de tela inteira exclusivo.</value>
  </data>
  <data name="Feature_GpuDriverTweaks.Header" xml:space="preserve">
    <value>Otimizações de desempenho do driver da GPU</value>
  </data>
  <data name="Feature_GpuDriverTweaks.Description" xml:space="preserve">
    <value>Aplica ajustes no Registro para AMD, NVIDIA e Intel a fim de reduzir a troca de estados de energia da GPU e a latência da tela.</value>
  </data>
  <data name="Feature_ExcludeDriversFromWindowsUpdates.Header" xml:space="preserve">
    <value>Excluir drivers das atualizações do Windows</value>
  </data>
  <data name="Feature_ExcludeDriversFromWindowsUpdates.Description" xml:space="preserve">
    <value>Exclui atualizações de driver do Windows Update. Pode levar a drivers desatualizados com potenciais riscos de segurança ou problemas de compatibilidade. Use com cautela.</value>
  </data>
  <data name="Feature_DisableSystemRestore.Header" xml:space="preserve">
    <value>Desabilitar restauração do sistema</value>
  </data>
  <data name="Feature_DisableSystemRestore.Description" xml:space="preserve">
    <value>Desabilita a restauração do sistema, que cria pontos de restauração para reverter o sistema a um estado anterior em caso de problemas. Não recomendado. Desabilitar esse recurso remove a capacidade de recuperação fácil de possíveis problemas no sistema.</value>
  </data>
  <data name="Feature_DisableCortana.Header" xml:space="preserve">
    <value>Desabilitar Cortana</value>
  </data>
  <data name="Feature_DisableCortana.Description" xml:space="preserve">
    <value>Desabilita a Cortana, a assistente virtual que pode responder perguntas e concluir tarefas. Pode afetar a pesquisa por voz e alguns recursos de produtividade.</value>
  </data>
  <data name="Feature_DisableStoreUpdates.Header" xml:space="preserve">
    <value>Desabilitar atualizações da loja</value>
  </data>
  <data name="Feature_DisableStoreUpdates.Description" xml:space="preserve">
    <value>Desabilita atualizações automáticas para aplicativos baixados da Microsoft Store. Pode deixar os aplicativos vulneráveis ​​a riscos de segurança ou sem novos recursos.</value>
  </data>
  <data name="Feature_DisableSMBv1.Header" xml:space="preserve">
    <value>Desabilitar SMBv1</value>
  </data>
  <data name="Feature_DisableSMBv1.Description" xml:space="preserve">
    <value>Desabilita o Server Message Block versão 1 (SMBv1) para maior segurança. Recomendado</value>
  </data>
  <data name="Feature_DisableSMBv2.Header" xml:space="preserve">
    <value>Desabilita o SMBv2</value>
  </data>
  <data name="Feature_DisableSMBv2.Description" xml:space="preserve">
    <value>Desabilita o Server Message Block versão 2 (SMBv2) para maior segurança. Use com cuidado, pois pode interromper as funcionalidades de compartilhamento de arquivos de rede.</value>
  </data>
  <data name="Feature_DisableTelemetryServices.Header" xml:space="preserve">
