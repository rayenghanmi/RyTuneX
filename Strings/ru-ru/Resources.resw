  <data name="Feature_EnableVerboseLogon.Description" xml:space="preserve">
    <value>Включите подробные сообщения о входе в систему для лучшего мониторинга и устранения неполадок. Может быть неудобным для повседневного использования</value>
  </data>
  <data name="Feature_EnableVerboseLogon.Header" xml:space="preserve">
    <value>Включить подробный вход</value>
  </data>
  <data name="SelecFold" xml:space="preserve">
    <value>Выберите папку</value>
  </data>
  <data name="SystemInfoPage_Drivers.Text" xml:space="preserve">
