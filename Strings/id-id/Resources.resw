  <data name="Feature_DisableHibernation.Header" xml:space="preserve">
    <value>Nonaktifkan Hibernasi</value>
  </data>
  <data name="Feature_DisableHibernation.Description" xml:space="preserve">
    <value>Matikan hibernasi untuk menghemat daya dan mencegah komputer masuk ke mode tidur. Tidak direkomendasikan untuk laptop</value>
  </data>
  <data name="Feature_DisableHomeGroup.Header" xml:space="preserve">
    <value>Nonaktifkan Home Group</value>
  </data>
  <data name="Feature_DisableHomeGroup.Description" xml:space="preserve">
    <value>Mematikan Home Group untuk menghentikan berbagi file dan printer dengan perangkat lain di jaringan</value>
  </data>
  <data name="Feature_DisablePrintService.Header" xml:space="preserve">
    <value>Nonaktifkan Layanan Cetak</value>
  </data>
  <data name="Feature_DisablePrintService.Description" xml:space="preserve">
    <value>Menonaktifkan layanan pencetakan, sehingga fungsi terkait pencetakan tidak dapat digunakan</value>
  </data>
  <data name="Feature_DisableCompatibilityAssistant.Header" xml:space="preserve">
    <value>Nonaktifkan Asisten Kompatibilitas</value>
  </data>
  <data name="Feature_DisableCompatibilityAssistant.Description" xml:space="preserve">
    <value>Mematikan Asisten Kompatibilitas untuk menonaktifkan pemeriksaan kompatibilitas otomatis untuk program</value>
  </data>
  <data name="Feature_DisableSearch.Header" xml:space="preserve">
    <value>Nonaktifkan Pencarian</value>
  </data>
  <data name="Feature_DisableSearch.Description" xml:space="preserve">
    <value>Mematikan fungsi pencarian di seluruh sistem</value>
  </data>
  <data name="Feature_DisableErrorReporting.Header" xml:space="preserve">
    <value>Nonaktifkan Pelaporan Kesalahan</value>
  </data>
  <data name="Feature_DisableErrorReporting.Description" xml:space="preserve">
    <value>Mematikan pelaporan kesalahan untuk mencegah pengiriman laporan kesalahan secara otomatis ke Microsoft</value>
  </data>
  <data name="Feature_DisableGameBar.Header" xml:space="preserve">
    <value>Nonaktifkan Game Bar</value>
  </data>
  <data name="Feature_DisableGameBar.Description" xml:space="preserve">
    <value>Mematikan Game Bar dan fitur terkaitnya</value>
  </data>
  <data name="Feature_DisableQuickAccessHistory.Header" xml:space="preserve">
    <value>Nonaktifkan Riwayat Akses Cepat</value>
  </data>
  <data name="Feature_DisableQuickAccessHistory.Description" xml:space="preserve">
    <value>Menonaktifkan pencatatan dan tampilan riwayat Akses Cepat</value>
  </data>
  <data name="Feature_DisableMyPeople.Header" xml:space="preserve">
    <value>Nonaktifkan My People</value>
  </data>
  <data name="Feature_DisableMyPeople.Description" xml:space="preserve">
    <value>Mematikan fitur My People di taskbar</value>
  </data>
  <data name="Feature_DisableWindowsInk.Header" xml:space="preserve">
    <value>Nonaktifkan Windows Ink</value>
  </data>
  <data name="Feature_DisableWindowsInk.Description" xml:space="preserve">
    <value>Mematikan Windows Ink Workspace dan fitur terkait. Tidak direkomendasikan untuk perangkat dengan stylus</value>
  </data>
  <data name="Feature_DisableSpellingAndTypingFeatures.Header" xml:space="preserve">
    <value>Nonaktifkan Fitur Ejaan dan Pengetikan</value>
  </data>
  <data name="Feature_DisableSpellingAndTypingFeatures.Description" xml:space="preserve">
    <value>Menonaktifkan saran ejaan dan pengetikan</value>
  </data>
  <data name="Feature_DisableFaxService.Header" xml:space="preserve">
    <value>Nonaktifkan Layanan Faks</value>
  </data>
  <data name="Feature_DisableFaxService.Description" xml:space="preserve">
    <value>Menonaktifkan layanan Faks di Windows</value>
  </data>
  <data name="Feature_DisableInsiderService.Header" xml:space="preserve">
    <value>Nonaktifkan Layanan Insider</value>
  </data>
  <data name="Feature_DisableInsiderService.Description" xml:space="preserve">
    <value>Keluar dari Program Windows Insider dan berhenti menerima build pratinjau</value>
  </data>
  <data name="Feature_DisableCloudClipboard.Header" xml:space="preserve">
    <value>Nonaktifkan Clipboard Cloud</value>
  </data>
  <data name="Feature_DisableCloudClipboard.Description" xml:space="preserve">
    <value>Menonaktifkan fitur Clipboard Cloud untuk berbagi clipboard antar perangkat</value>
  </data>
  <data name="Feature_DisableStickyKeys.Header" xml:space="preserve">
    <value>Nonaktifkan Sticky Keys</value>
  </data>
  <data name="Feature_DisableStickyKeys.Description" xml:space="preserve">
    <value>Menonaktifkan fitur aksesibilitas Sticky Keys. Berguna bagi orang yang tidak sengaja menekan beberapa tombol sekaligus</value>
  </data>
  <data name="Feature_DisableCastToDevice.Header" xml:space="preserve">
    <value>Nonaktifkan Cast ke Perangkat</value>
  </data>
  <data name="Feature_DisableCastToDevice.Description" xml:space="preserve">
    <value>Menonaktifkan fitur Cast ke Perangkat di Windows. Berguna untuk presentasi atau berbagi media ke perangkat lain</value>
  </data>
  <data name="Feature_DisableVBS.Header" xml:space="preserve">
    <value>Nonaktifkan VBS</value>
  </data>
  <data name="Feature_DisableVBS.Description" xml:space="preserve">
    <value>Menonaktifkan Virtualization-Based Security (VBS) untuk fitur keamanan tingkat lanjut. Tidak direkomendasikan untuk lingkungan dengan keamanan tinggi</value>
  </data>
  <data name="Feature_MoveTaskbarToLeft.Header" xml:space="preserve">
    <value>Pindahkan Taskbar ke Kiri</value>
  </data>
  <data name="Feature_MoveTaskbarToLeft.Description" xml:space="preserve">
    <value>Memindahkan taskbar dari posisi default di bawah ke sisi kiri layar. Preferensi pribadi</value>
  </data>
  <data name="Feature_DisableSnapAssist.Header" xml:space="preserve">
    <value>Nonaktifkan Snap Assist</value>
  </data>
  <data name="Feature_DisableSnapAssist.Description" xml:space="preserve">
    <value>Menonaktifkan Snap Assist, yang secara otomatis mengatur jendela terbuka saat diseret. Berguna untuk multitasking tetapi beberapa pengguna lebih memilih pengelolaan jendela manual</value>
  </data>
  <data name="Feature_DisableWidgets.Header" xml:space="preserve">
    <value>Nonaktifkan Widget</value>
  </data>
  <data name="Feature_DisableWidgets.Description" xml:space="preserve">
    <value>Menonaktifkan fitur Widget pada taskbar Windows 11. Pertimbangkan jika Anda merasa widget berguna untuk pembaruan cepat (khusus Windows 11)</value>
  </data>
  <data name="Feature_DisableChat.Header" xml:space="preserve">
    <value>Nonaktifkan Chat</value>
  </data>
  <data name="Feature_DisableChat.Description" xml:space="preserve">
    <value>Menonaktifkan fitur Chat pada taskbar Windows 11. Hanya direkomendasikan jika Anda tidak menggunakan fitur chat untuk komunikasi (khusus Windows 11)</value>
  </data>
  <data name="Feature_EnableFilesCompactMode.Header" xml:space="preserve">
    <value>Aktifkan Mode Kompak File</value>
  </data>
  <data name="Feature_EnableFilesCompactMode.Description" xml:space="preserve">
    <value>Mengaktifkan Mode Kompak untuk penelusuran file dengan thumbnail lebih kecil. Berguna untuk layar resolusi rendah atau mengelola folder besar</value>
  </data>
  <data name="Feature_DisableStickers.Header" xml:space="preserve">
    <value>Nonaktifkan Stiker</value>
  </data>
  <data name="Feature_DisableStickers.Description" xml:space="preserve">
    <value>Menonaktifkan fitur Stiker di aplikasi pesan Windows 11. Hanya direkomendasikan jika Anda tidak menggunakan stiker untuk komunikasi (khusus Windows 11)</value>
  </data>
  <data name="Feature_DisableEdgeDiscoverBar.Header" xml:space="preserve">
    <value>Nonaktifkan Bilah Discover Edge</value>
  </data>
  <data name="Feature_DisableEdgeDiscoverBar.Description" xml:space="preserve">
    <value>Menonaktifkan fitur Discover Bar di Microsoft Edge. Berguna jika Anda merasa terganggu atau lebih menyukai antarmuka browser yang lebih bersih</value>
  </data>
  <data name="Feature_DisableCoPilotAI.Header" xml:space="preserve">
    <value>Nonaktifkan CoPilot AI</value>
  </data>
  <data name="Feature_DisableCoPilotAI.Description" xml:space="preserve">
    <value>Menonaktifkan fitur CoPilot AI di Windows untuk bantuan menulis kode. Tidak direkomendasikan untuk pengembang</value>
  </data>
  <data name="Feature_DisableSysMain.Header" xml:space="preserve">
    <value>Nonaktifkan SysMain</value>
  </data>
  <data name="Feature_DisableSysMain.Description" xml:space="preserve">
    <value>Mematikan SysMain, yang memuat prapemuatan aplikasi yang sering digunakan agar startup lebih cepat. Mungkin berdampak pada waktu startup untuk beberapa program jika Anda menggunakan HDD.</value>
  </data>
  <data name="Feature_EnableGamingMode.Header" xml:space="preserve">
    <value>Aktifkan Gaming Mode</value>
  </data>
  <data name="Feature_EnableGamingMode.Description" xml:space="preserve">
    <value>Mengaktifkan Gaming Mode, yang mengoptimalkan sumber daya sistem untuk pengalaman bermain game yang lebih lancar. Mungkin memengaruhi proses di latar belakang.</value>
  </data>
  <data name="Feature_EnableFullscreenOptimizations.Header" xml:space="preserve">
    <value>Aktifkan Optimasi Layar Penuh</value>
  </data>
  <data name="Feature_EnableFullscreenOptimizations.Description" xml:space="preserve">
    <value>Memungkinkan Windows menggunakan jalur optimasi layar penuh untuk game. Nonaktifkan opsi ini hanya untuk game yang memerlukan mode layar penuh eksklusif.</value>
  </data>
  <data name="Feature_GpuDriverTweaks.Header" xml:space="preserve">
    <value>Penyesuaian Performa Driver GPU</value>
  </data>
  <data name="Feature_GpuDriverTweaks.Description" xml:space="preserve">
    <value>Menerapkan penyesuaian registri untuk AMD, NVIDIA, dan Intel guna mengurangi perpindahan status daya GPU serta latensi tampilan.</value>
  </data>
  <data name="Feature_ExcludeDriversFromWindowsUpdates.Header" xml:space="preserve">
    <value>Kecualikan Driver Dari Pembaruan Windows</value>
  </data>
  <data name="Feature_ExcludeDriversFromWindowsUpdates.Description" xml:space="preserve">
    <value>Mengecualikan pembaruan driver dari Windows Update. Mungkin menyebabkan driver kedaluwarsa dengan potensi risiko keamanan atau masalah kompatibilitas. Gunakan dengan hati-hati.</value>
  </data>
  <data name="Feature_DisableSystemRestore.Header" xml:space="preserve">
    <value>Nonaktifkan System Restore</value>
  </data>
  <data name="Feature_DisableSystemRestore.Description" xml:space="preserve">
    <value>Menonaktifkan System Restore, yang membuat titik pemulihan untuk mengembalikan sistem ke keadaan sebelumnya jika terjadi masalah. Tidak direkomendasikan. Menonaktifkan fitur ini menghilangkan kemampuan untuk pulih dengan mudah dari potensi masalah sistem.</value>
  </data>
  <data name="Feature_DisableCortana.Header" xml:space="preserve">
    <value>Nonaktifkan Cortana</value>
  </data>
  <data name="Feature_DisableCortana.Description" xml:space="preserve">
    <value>Menonaktifkan Cortana, asisten virtual yang dapat menjawab pertanyaan dan menyelesaikan tugas. Mungkin berdampak pada pencarian suara dan beberapa fitur produktivitas.</value>
  </data>
  <data name="Feature_DisableStoreUpdates.Header" xml:space="preserve">
    <value>Nonaktifkan Pembaruan Store</value>
  </data>
  <data name="Feature_DisableStoreUpdates.Description" xml:space="preserve">
    <value>Menonaktifkan pembaruan otomatis untuk aplikasi yang diunduh dari Microsoft Store. Mungkin membuat aplikasi rentan terhadap risiko keamanan atau kehilangan fitur baru.</value>
  </data>
  <data name="Feature_DisableSMBv1.Header" xml:space="preserve">
    <value>Nonaktifkan SMBv1</value>
  </data>
  <data name="Feature_DisableSMBv1.Description" xml:space="preserve">
    <value>Menonaktifkan Server Message Block versi 1 (SMBv1) untuk peningkatan keamanan. Direkomendasikan</value>
  </data>
