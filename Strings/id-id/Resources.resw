  <data name="Feature_EnableVerboseLogon.Description" xml:space="preserve">
    <value>Aktifkan pesan logon terperinci untuk pemantauan sistem dan pemecahan masalah yang lebih baik. Mungkin tidak ramah pengguna untuk penggunaan sehari-hari</value>
  </data>
  <data name="Feature_EnableVerboseLogon.Header" xml:space="preserve">
    <value>Aktifkan Logon Verbose</value>
  </data>
  <data name="SelecFold" xml:space="preserve">
