  </data>
  <data name="Feature_DisableHibernation.Header" xml:space="preserve">
    <value>Désactiver l'Hibernation</value>
  </data>
  <data name="Feature_DisableHibernation.Description" xml:space="preserve">
    <value>Désactive l'hibernation pour économiser de l'énergie et empêcher l'ordinateur d'entrer en mode veille. Non recommandé pour les ordinateurs portables.</value>
  </data>
  <data name="Feature_DisableHomeGroup.Header" xml:space="preserve">
    <value>Désactiver le Groupe Domestique</value>
  </data>
  <data name="Feature_DisableHomeGroup.Description" xml:space="preserve">
    <value>Désactive le Groupe Domestique pour arrêter le partage de fichiers et d'imprimantes avec d'autres appareils sur le réseau.</value>
  </data>
  <data name="Feature_DisablePrintService.Header" xml:space="preserve">
    <value>Désactiver le Service d'Impression</value>
  </data>
  <data name="Feature_DisablePrintService.Description" xml:space="preserve">
    <value>Désactive le service d'impression, empêchant les fonctionnalités liées à l'impression.</value>
  </data>
  <data name="Feature_DisableCompatibilityAssistant.Header" xml:space="preserve">
    <value>Désactiver l'Assistant de Compatibilité</value>
  </data>
  <data name="Feature_DisableCompatibilityAssistant.Description" xml:space="preserve">
    <value>Désactive l'Assistant de Compatibilité pour désactiver les vérifications automatiques de compatibilité des programmes.</value>
  </data>
  <data name="Feature_DisableSearch.Header" xml:space="preserve">
    <value>Désactiver la Recherche</value>
  </data>
  <data name="Feature_DisableSearch.Description" xml:space="preserve">
    <value>Désactive la fonctionnalité de recherche à l'échelle du système.</value>
  </data>
  <data name="Feature_DisableErrorReporting.Header" xml:space="preserve">
    <value>Désactiver le Rapport d'Erreurs</value>
  </data>
  <data name="Feature_DisableErrorReporting.Description" xml:space="preserve">
    <value>Désactive le rapport d'erreurs pour empêcher l'envoi automatique de rapports d'erreurs à Microsoft.</value>
  </data>
  <data name="Feature_DisableGameBar.Header" xml:space="preserve">
    <value>Désactiver la Barre de Jeu</value>
  </data>
  <data name="Feature_DisableGameBar.Description" xml:space="preserve">
    <value>Désactive la Barre de Jeu et ses fonctionnalités associées.</value>
  </data>
  <data name="Feature_DisableQuickAccessHistory.Header" xml:space="preserve">
    <value>Désactiver l'Histoire d'Accès Rapide</value>
  </data>
  <data name="Feature_DisableQuickAccessHistory.Description" xml:space="preserve">
    <value>Désactive l'enregistrement et l'affichage de l'historique d'accès rapide.</value>
  </data>
  <data name="Feature_DisableMyPeople.Header" xml:space="preserve">
    <value>Désactiver Mes Contacts</value>
  </data>
  <data name="Feature_DisableMyPeople.Description" xml:space="preserve">
    <value>Désactive la fonctionnalité Mes Contacts dans la barre des tâches.</value>
  </data>
  <data name="Feature_DisableWindowsInk.Header" xml:space="preserve">
    <value>Désactiver Windows Ink</value>
  </data>
  <data name="Feature_DisableWindowsInk.Description" xml:space="preserve">
    <value>Désactive l'Espace de Travail Windows Ink et les fonctionnalités associées. Non recommandé pour les appareils avec un stylet.</value>
  </data>
  <data name="Feature_DisableSpellingAndTypingFeatures.Header" xml:space="preserve">
    <value>Désactiver les Fonctionnalités d'Orthographe et de Saisie</value>
  </data>
  <data name="Feature_DisableSpellingAndTypingFeatures.Description" xml:space="preserve">
    <value>Désactive les suggestions d'orthographe et de saisie.</value>
  </data>
  <data name="Feature_DisableFaxService.Header" xml:space="preserve">
    <value>Désactiver le Service de Fax</value>
  </data>
  <data name="Feature_DisableFaxService.Description" xml:space="preserve">
    <value>Désactive le service de fax dans Windows.</value>
  </data>
  <data name="Feature_DisableInsiderService.Header" xml:space="preserve">
    <value>Désactiver le Service Insider</value>
  </data>
  <data name="Feature_DisableInsiderService.Description" xml:space="preserve">
    <value>Se désinscrire du programme Windows Insider et cesser de recevoir des versions de prévisualisation.</value>
  </data>
  <data name="Feature_DisableCloudClipboard.Header" xml:space="preserve">
    <value>Désactiver le Presse-Papiers Cloud</value>
  </data>
  <data name="Feature_DisableCloudClipboard.Description" xml:space="preserve">
    <value>Désactive la fonctionnalité Presse-Papiers Cloud pour le partage du presse-papiers entre appareils.</value>
  </data>
  <data name="Feature_DisableStickyKeys.Header" xml:space="preserve">
    <value>Désactiver les Touches Verrouillées</value>
  </data>
  <data name="Feature_DisableStickyKeys.Description" xml:space="preserve">
    <value>Désactive la fonctionnalité d'accessibilité Touches Verrouillées. Utile pour les personnes qui appuient accidentellement sur plusieurs touches à la fois.</value>
  </data>
  <data name="Feature_DisableCastToDevice.Header" xml:space="preserve">
    <value>Désactiver le Cast sur Appareil</value>
  </data>
  <data name="Feature_DisableCastToDevice.Description" xml:space="preserve">
    <value>Désactive la fonctionnalité de Cast sur Appareil dans Windows. Utile pour les présentations ou le partage de médias sur d'autres appareils.</value>
  </data>
  <data name="Feature_DisableVBS.Header" xml:space="preserve">
    <value>Désactiver VBS</value>
  </data>
  <data name="Feature_DisableVBS.Description" xml:space="preserve">
    <value>Désactive la Sécurité Basée sur la Virtualisation (VBS) pour des fonctionnalités de sécurité avancées. Non recommandé pour les environnements à haute sécurité.</value>
  </data>
  <data name="Feature_MoveTaskbarToLeft.Header" xml:space="preserve">
    <value>Déplacer la Barre des Tâches à Gauche</value>
  </data>
  <data name="Feature_MoveTaskbarToLeft.Description" xml:space="preserve">
    <value>Déplace la barre des tâches de la position par défaut en bas vers le côté gauche de l'écran. Préférence personnelle.</value>
  </data>
  <data name="Feature_DisableSnapAssist.Header" xml:space="preserve">
    <value>Désactiver l'Assistance Snap</value>
  </data>
  <data name="Feature_DisableSnapAssist.Description" xml:space="preserve">
    <value>Désactive l'Assistance Snap, qui organise automatiquement les fenêtres ouvertes lors du déplacement. Utile pour le multitâche, mais certains utilisateurs préfèrent la gestion manuelle des fenêtres.</value>
  </data>
  <data name="Feature_DisableWidgets.Header" xml:space="preserve">
    <value>Désactiver les Widgets</value>
  </data>
  <data name="Feature_DisableWidgets.Description" xml:space="preserve">
    <value>Désactive la fonctionnalité Widgets sur la barre des tâches de Windows 11. À considérer si vous trouvez les widgets utiles pour les mises à jour rapides (Windows 11 uniquement).</value>
  </data>
  <data name="Feature_DisableChat.Header" xml:space="preserve">
    <value>Désactiver le Chat</value>
  </data>
  <data name="Feature_DisableChat.Description" xml:space="preserve">
    <value>Désactive la fonctionnalité Chat sur la barre des tâches de Windows 11. Recommandé uniquement si vous n'utilisez pas la fonctionnalité chat pour la communication (Windows 11 uniquement).</value>
  </data>
  <data name="Feature_EnableFilesCompactMode.Header" xml:space="preserve">
    <value>Activer le Mode Compact des Fichiers</value>
  </data>
  <data name="Feature_EnableFilesCompactMode.Description" xml:space="preserve">
    <value>Active le Mode Compact pour la navigation dans les fichiers avec de plus petites vignettes. Utile pour les affichages de faible résolution ou la gestion de grands dossiers.</value>
  </data>
  <data name="Feature_DisableStickers.Header" xml:space="preserve">
    <value>Désactiver les Autocollants</value>
  </data>
  <data name="Feature_DisableStickers.Description" xml:space="preserve">
    <value>Désactive la fonctionnalité Autocollants dans l'application de messagerie de Windows 11. Recommandé uniquement si vous n'utilisez pas les autocollants pour la communication (Windows 11 uniquement).</value>
  </data>
  <data name="Feature_DisableEdgeDiscoverBar.Header" xml:space="preserve">
    <value>Désactiver la Barre de Découverte Edge</value>
  </data>
  <data name="Feature_DisableEdgeDiscoverBar.Description" xml:space="preserve">
    <value>Désactive la fonctionnalité Barre de Découverte dans Microsoft Edge. Utile si vous la trouvez distrayante ou si vous préférez une interface de navigateur plus épurée.</value>
  </data>
  <data name="Feature_DisableCoPilotAI.Header" xml:space="preserve">
    <value>Désactiver CoPilot AI</value>
  </data>
  <data name="Feature_DisableCoPilotAI.Description" xml:space="preserve">
    <value>Désactive la fonctionnalité CoPilot AI dans Windows pour l'assistance à la rédaction de code. Non recommandé pour les développeurs.</value>
  </data>
  <data name="Feature_DisableSysMain.Header" xml:space="preserve">
    <value>Désactiver SysMain</value>
  </data>
  <data name="Feature_DisableSysMain.Description" xml:space="preserve">
    <value>Désactive SysMain, qui précharge les applications fréquemment utilisées pour un démarrage plus rapide. Peut affecter les temps de démarrage pour certains programmes si vous utilisez un HDD.</value>
  </data>
  <data name="Feature_EnableGamingMode.Header" xml:space="preserve">
    <value>Activer le Mode Jeu</value>
  </data>
  <data name="Feature_EnableGamingMode.Description" xml:space="preserve">
    <value>Active le Mode Jeu, qui optimise les ressources du système pour une expérience de jeu plus fluide. Peut affecter les processus en arrière-plan.</value>
  </data>
  <data name="Feature_EnableFullscreenOptimizations.Header" xml:space="preserve">
    <value>Activer les optimisations plein écran</value>
  </data>
  <data name="Feature_EnableFullscreenOptimizations.Description" xml:space="preserve">
    <value>Permet à Windows d'utiliser son mode d'optimisation plein écran pour les jeux. Désactivez cette option uniquement pour les jeux nécessitant un mode plein écran exclusif.</value>
  </data>
  <data name="Feature_GpuDriverTweaks.Header" xml:space="preserve">
    <value>Optimisations des performances du pilote graphique</value>
  </data>
  <data name="Feature_GpuDriverTweaks.Description" xml:space="preserve">
    <value>Applique des ajustements du registre pour les GPU AMD, NVIDIA et Intel afin de réduire les changements d'état d'alimentation du GPU et la latence d'affichage.</value>
  </data>
  <data name="Feature_ExcludeDriversFromWindowsUpdates.Header" xml:space="preserve">
    <value>Exclure les Pilotes des Mises à Jour Windows</value>
  </data>
  <data name="Feature_ExcludeDriversFromWindowsUpdates.Description" xml:space="preserve">
    <value>Exclut les mises à jour de pilotes de Windows Update. Peut entraîner des pilotes obsolètes avec des risques de sécurité potentiels ou des problèmes de compatibilité. Utilisez avec prudence.</value>
  </data>
  <data name="Feature_DisableSystemRestore.Header" xml:space="preserve">
    <value>Désactiver la Restauration du Système</value>
  </data>
  <data name="Feature_DisableSystemRestore.Description" xml:space="preserve">
    <value>Désactive la Restauration du Système, qui crée des points de restauration pour revenir à un état précédent en cas de problèmes. Non recommandé. Désactiver cette fonctionnalité supprime la capacité de récupérer facilement d'éventuels problèmes système.</value>
  </data>
  <data name="Feature_DisableCortana.Header" xml:space="preserve">
    <value>Désactiver Cortana</value>
  </data>
  <data name="Feature_DisableCortana.Description" xml:space="preserve">
    <value>Désactive Cortana, l'assistant virtuel qui peut répondre aux questions et effectuer des tâches. Peut affecter la recherche vocale et certaines fonctionnalités de productivité.</value>
  </data>
  <data name="Feature_DisableStoreUpdates.Header" xml:space="preserve">
    <value>Désactiver les Mises à Jour du Store</value>
  </data>
  <data name="Feature_DisableStoreUpdates.Description" xml:space="preserve">
    <value>Désactive les mises à jour automatiques pour les applications téléchargées depuis le Microsoft Store. Peut rendre les applications vulnérables aux risques de sécurité ou manquantes de nouvelles fonctionnalités.</value>
  </data>
  <data name="Feature_DisableSMBv1.Header" xml:space="preserve">
    <value>Désactiver SMBv1</value>
  </data>
  <data name="Feature_DisableSMBv1.Description" xml:space="preserve">
