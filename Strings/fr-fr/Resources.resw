  <data name="Feature_EnableVerboseLogon.Description" xml:space="preserve">
    <value>Activer les messages de connexion détaillés pour une meilleure surveillance et résolution des problèmes système. Peut ne pas être convivial pour une utilisation quotidienne.</value>
  </data>
  <data name="Feature_EnableVerboseLogon.Header" xml:space="preserve">
    <value>Activer la Connexion Détaillée</value>
  </data>
  <data name="SelecFold" xml:space="preserve">
    <value>Sélectionnez un dossier</value>
  </data>
  <data name="SystemInfoPage_Drivers.Text" xml:space="preserve">
