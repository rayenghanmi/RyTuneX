    <value>فحص</value>
  </data>
  <data name="RepairPage_RepairButton.Content" xml:space="preserve">
    <value>إصلاح</value>
  </data>
  <data name="RepairPage_StopButton.Content" xml:space="preserve">
    <value>إيقاف</value>
  </data>
  <data name="RepairPage_StatusTextBlock.Text" xml:space="preserve">
    <value>اختر على الأقل خيارًا واحدًا للفحص/الإصلاح</value>
  </data>
  <data name="StatusTextBlockDefault" xml:space="preserve">
    <value>اختر على الأقل خيارًا واحدًا للفحص/الإصلاح</value>
  </data>
  <data name="RepairPage_BatteryHealth.Header" xml:space="preserve">
    <value>حالة البطارية</value>
  </data>
  <data name="RepairPage_BatteryHealth.Description" xml:space="preserve">
    <value>سيتم إنشاء تقرير كامل عن حالة بطاريتك</value>
  </data>
  <data name="RepairPage_BatteryHealthGenerate.Content" xml:space="preserve">
    <value>توليد</value>
  </data>
  <data name="RepairPage_MemoryDiagnostic.Header" xml:space="preserve">
    <value>تشخيص الذاكرة</value>
  </data>
  <data name="RepairPage_MemoryDiagnostic.Description" xml:space="preserve">
    <value>قم بتحليل ذاكرة نظامك لمشاكل محتملة وتحسين الاستقرار</value>
  </data>
  <data name="RepairPage_MemoryDiagnosticButton.Content" xml:space="preserve">
    <value>تشخيص</value>
  </data>
  <data name="RepairPage_DiskOptimizations.Header" xml:space="preserve">
    <value>تحسينات القرص</value>
  </data>
  <data name="RepairPage_DiskOptimizations.Description" xml:space="preserve">
    <value>سيتم تحسين جهاز التخزين الخاص بك عن طريق تجزئته (إذا كان HDD) أو إعادة ترتيبه (إذا كان SSD)</value>
  </data>
  <data name="RepairPage_DiskOptimizationsButton.Content" xml:space="preserve">
    <value>تحسين</value>
  </data>
  <data name="RepairPage_EventViewer.Header" xml:space="preserve">
    <value>عارض الأحداث</value>
  </data>
  <data name="RepairPage_EventViewer.Description" xml:space="preserve">
    <value>سيتم عرض سجلات الأحداث الأخيرة للنظام لأغراض استكشاف الأخطاء وإصلاحها</value>
  </data>
  <data name="RepairPage_RepairOptions.Text" xml:space="preserve">
    <value>خيارات الإصلاح</value>
  </data>
  <data name="RepairPage_DiagnoseOptions.Text" xml:space="preserve">
    <value>خيارات التشخيص</value>
  </data>
  <data name="OperationCompleted" xml:space="preserve">
