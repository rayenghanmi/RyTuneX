  <data name="Feature_DisableHibernation.Header" xml:space="preserve">
    <value>Desactivar Hibernación</value>
  </data>
  <data name="Feature_DisableHibernation.Description" xml:space="preserve">
    <value>Desactiva la hibernación para ahorrar energía y evitar que el equipo entre en modo de suspensión. No recomendado para portátiles</value>
  </data>
  <data name="Feature_DisableHomeGroup.Header" xml:space="preserve">
    <value>Desactivar Grupo en Casa</value>
  </data>
  <data name="Feature_DisableHomeGroup.Description" xml:space="preserve">
    <value>Desactiva el Grupo en Casa para dejar de compartir archivos e impresoras con otros dispositivos en la red</value>
  </data>
  <data name="Feature_DisablePrintService.Header" xml:space="preserve">
    <value>Desactivar Servicio de Impresión</value>
  </data>
  <data name="Feature_DisablePrintService.Description" xml:space="preserve">
    <value>Desactiva el servicio de impresión, impidiendo las funcionalidades relacionadas con la impresión</value>
  </data>
  <data name="Feature_DisableCompatibilityAssistant.Header" xml:space="preserve">
    <value>Desactivar Asistente de Compatibilidad</value>
  </data>
  <data name="Feature_DisableCompatibilityAssistant.Description" xml:space="preserve">
    <value>Desactiva el Asistente de Compatibilidad para deshabilitar las comprobaciones automáticas de compatibilidad para programas</value>
  </data>
  <data name="Feature_DisableSearch.Header" xml:space="preserve">
    <value>Desactivar Búsqueda</value>
  </data>
  <data name="Feature_DisableSearch.Description" xml:space="preserve">
    <value>Desactiva la funcionalidad de búsqueda a nivel del sistema</value>
  </data>
  <data name="Feature_DisableErrorReporting.Header" xml:space="preserve">
    <value>Desactivar Informe de Errores</value>
  </data>
  <data name="Feature_DisableErrorReporting.Description" xml:space="preserve">
    <value>Desactiva el informe de errores para evitar el envío automático de informes a Microsoft</value>
  </data>
  <data name="Feature_DisableGameBar.Header" xml:space="preserve">
    <value>Desactivar Barra de Juegos</value>
  </data>
  <data name="Feature_DisableGameBar.Description" xml:space="preserve">
    <value>Desactiva la Barra de Juegos y sus características asociadas</value>
  </data>
  <data name="Feature_DisableQuickAccessHistory.Header" xml:space="preserve">
    <value>Desactivar Historial de Acceso Rápido</value>
  </data>
  <data name="Feature_DisableQuickAccessHistory.Description" xml:space="preserve">
    <value>Desactiva el registro y la visualización del historial de Acceso Rápido</value>
  </data>
  <data name="Feature_DisableMyPeople.Header" xml:space="preserve">
    <value>Desactivar Mi Gente</value>
  </data>
  <data name="Feature_DisableMyPeople.Description" xml:space="preserve">
    <value>Desactiva la función Mi Gente en la barra de tareas</value>
  </data>
  <data name="Feature_DisableWindowsInk.Header" xml:space="preserve">
    <value>Desactivar Windows Ink</value>
  </data>
  <data name="Feature_DisableWindowsInk.Description" xml:space="preserve">
    <value>Desactiva el Espacio de trabajo Windows Ink y las características relacionadas. No recomendado para dispositivos con un lápiz óptico</value>
  </data>
  <data name="Feature_DisableSpellingAndTypingFeatures.Header" xml:space="preserve">
    <value>Desactivar Características de Ortografía y Escritura</value>
  </data>
  <data name="Feature_DisableSpellingAndTypingFeatures.Description" xml:space="preserve">
    <value>Desactiva las sugerencias de ortografía y escritura</value>
  </data>
  <data name="Feature_DisableFaxService.Header" xml:space="preserve">
    <value>Desactivar Servicio de Fax</value>
  </data>
  <data name="Feature_DisableFaxService.Description" xml:space="preserve">
    <value>Desactiva el servicio de fax en Windows</value>
  </data>
  <data name="Feature_DisableInsiderService.Header" xml:space="preserve">
    <value>Desactivar Servicio Insider</value>
  </data>
  <data name="Feature_DisableInsiderService.Description" xml:space="preserve">
    <value>Dejar de participar en el Programa Insider de Windows y dejar de recibir versiones preliminares</value>
  </data>
  <data name="Feature_DisableCloudClipboard.Header" xml:space="preserve">
    <value>Desactivar Portapapeles en la Nube</value>
  </data>
  <data name="Feature_DisableCloudClipboard.Description" xml:space="preserve">
    <value>Desactiva la función Portapapeles en la Nube para compartir el portapapeles entre dispositivos</value>
  </data>
  <data name="Feature_DisableStickyKeys.Header" xml:space="preserve">
    <value>Desactivar Teclas Pegajosas</value>
  </data>
  <data name="Feature_DisableStickyKeys.Description" xml:space="preserve">
    <value>Desactiva la función de accesibilidad Teclas Pegajosas. Útil para personas que presionan varias teclas al mismo tiempo por accidente</value>
  </data>
  <data name="Feature_DisableCastToDevice.Header" xml:space="preserve">
    <value>Desactivar Enviar a Dispositivo</value>
  </data>
  <data name="Feature_DisableCastToDevice.Description" xml:space="preserve">
    <value>Desactiva la función Enviar a Dispositivo en Windows. Útil para presentaciones o compartir medios en otros dispositivos</value>
  </data>
  <data name="Feature_DisableVBS.Header" xml:space="preserve">
    <value>Desactivar VBS</value>
  </data>
  <data name="Feature_DisableVBS.Description" xml:space="preserve">
    <value>Desactiva la Seguridad Basada en Virtualización (VBS) para características avanzadas de seguridad. No recomendado para entornos de alta seguridad</value>
  </data>
  <data name="Feature_MoveTaskbarToLeft.Header" xml:space="preserve">
    <value>Mover Barra de Tareas a la Izquierda</value>
  </data>
  <data name="Feature_MoveTaskbarToLeft.Description" xml:space="preserve">
    <value>Mueve la barra de tareas desde su posición predeterminada en la parte inferior hacia el lado izquierdo de la pantalla. Preferencia personal</value>
  </data>
  <data name="Feature_DisableSnapAssist.Header" xml:space="preserve">
    <value>Desactivar Asistencia de Ajuste</value>
  </data>
  <data name="Feature_DisableSnapAssist.Description" xml:space="preserve">
    <value>Desactiva Asistencia de Ajuste, que organiza automáticamente las ventanas abiertas al arrastrarlas. Útil para multitareas, pero algunos usuarios prefieren gestionar las ventanas manualmente</value>
  </data>
  <data name="Feature_DisableWidgets.Header" xml:space="preserve">
    <value>Desactivar Widgets</value>
  </data>
  <data name="Feature_DisableWidgets.Description" xml:space="preserve">
    <value>Desactiva la función de Widgets en la barra de tareas de Windows 11. Considera si encuentras útiles los widgets para obtener actualizaciones rápidas (solo Windows 11)</value>
  </data>
  <data name="Feature_DisableChat.Header" xml:space="preserve">
    <value>Desactivar Chat</value>
  </data>
  <data name="Feature_DisableChat.Description" xml:space="preserve">
    <value>Desactiva la función Chat en la barra de tareas de Windows 11. Solo recomendado si no usas la función de chat para comunicación (solo Windows 11)</value>
  </data>
  <data name="Feature_EnableFilesCompactMode.Header" xml:space="preserve">
    <value>Habilitar Modo Compacto de Archivos</value>
  </data>
  <data name="Feature_EnableFilesCompactMode.Description" xml:space="preserve">
    <value>Habilita el Modo Compacto para la navegación de archivos con miniaturas más pequeñas. Útil para pantallas de baja resolución o para gestionar carpetas grandes</value>
  </data>
  <data name="Feature_DisableStickers.Header" xml:space="preserve">
    <value>Desactivar Stickers</value>
  </data>
  <data name="Feature_DisableStickers.Description" xml:space="preserve">
    <value>Desactiva la función Stickers en la aplicación de mensajería de Windows 11. Solo recomendado si no usas stickers para comunicación (solo Windows 11)</value>
  </data>
  <data name="Feature_DisableEdgeDiscoverBar.Header" xml:space="preserve">
    <value>Desactivar Barra de Descubrimiento de Edge</value>
  </data>
  <data name="Feature_DisableEdgeDiscoverBar.Description" xml:space="preserve">
    <value>Desactiva la función Discover Bar en Microsoft Edge. Útil si te resulta molesta o prefieres una interfaz de navegador más limpia.</value>
  </data>
  <data name="Feature_DisableCoPilotAI.Header" xml:space="preserve">
    <value>Desactivar CoPilot AI</value>
  </data>
  <data name="Feature_DisableCoPilotAI.Description" xml:space="preserve">
    <value>Desactiva la función CoPilot AI en Windows para asistencia en la escritura de código. No recomendado para desarrolladores.</value>
  </data>
  <data name="OptimizeBasic.Text" xml:space="preserve">
    <value>Optimizaciones Básicas</value>
  </data>
  <data name="Feature_PerformanceTweaks.Header" xml:space="preserve">
    <value>Ajustes de Rendimiento</value>
  </data>
  <data name="Feature_DisableSysMain.Header" xml:space="preserve">
    <value>Desactivar SysMain</value>
  </data>
  <data name="Feature_DisableSysMain.Description" xml:space="preserve">
    <value>Desactiva SysMain, que precarga aplicaciones de uso frecuente para un inicio más rápido. Puede afectar los tiempos de inicio de algunos programas si usas un HDD.</value>
  </data>
  <data name="Feature_EnableGamingMode.Header" xml:space="preserve">
    <value>Activar Modo Juego</value>
  </data>
  <data name="Feature_EnableGamingMode.Description" xml:space="preserve">
    <value>Activa el Modo Juego, que optimiza los recursos del sistema para una experiencia de juego más fluida. Puede afectar los procesos en segundo plano.</value>
  </data>
  <data name="Feature_EnableFullscreenOptimizations.Header" xml:space="preserve">
    <value>Activar optimizaciones de pantalla completa</value>
  </data>
  <data name="Feature_EnableFullscreenOptimizations.Description" xml:space="preserve">
    <value>Permite que Windows utilice su optimización de pantalla completa para los juegos. Desactiva esta opción solo en juegos que requieran el modo de pantalla completa exclusiva.</value>
  </data>
  <data name="Feature_GpuDriverTweaks.Header" xml:space="preserve">
    <value>Ajustes de rendimiento del controlador de la GPU</value>
  </data>
  <data name="Feature_GpuDriverTweaks.Description" xml:space="preserve">
    <value>Aplica ajustes del registro para AMD, NVIDIA e Intel con el fin de reducir los cambios de estado de energía de la GPU y la latencia de la pantalla.</value>
  </data>
  <data name="Feature_ExcludeDriversFromWindowsUpdates.Header" xml:space="preserve">
    <value>Excluir Controladores de las Actualizaciones de Windows</value>
  </data>
  <data name="Feature_ExcludeDriversFromWindowsUpdates.Description" xml:space="preserve">
    <value>Excluye las actualizaciones de controladores de Windows Update. Puede resultar en controladores desactualizados con riesgos de seguridad o problemas de compatibilidad. Úsalo con precaución.</value>
  </data>
  <data name="OptimizeAdvanced.Text" xml:space="preserve">
    <value>Optimizaciones Avanzadas</value>
  </data>
  <data name="Feature_DisableSystemRestore.Header" xml:space="preserve">
    <value>Desactivar Restauración del Sistema</value>
  </data>
  <data name="Feature_DisableSystemRestore.Description" xml:space="preserve">
    <value>Desactiva Restauración del Sistema, que crea puntos de restauración para revertir el sistema a un estado anterior en caso de problemas. No recomendado. Desactivar esta función elimina la capacidad de recuperar fácilmente el sistema ante posibles problemas.</value>
  </data>
  <data name="Feature_DisableCortana.Header" xml:space="preserve">
    <value>Desactivar Cortana</value>
  </data>
  <data name="Feature_DisableCortana.Description" xml:space="preserve">
    <value>Desactiva Cortana, el asistente virtual que puede responder preguntas y realizar tareas. Puede afectar la búsqueda por voz y algunas funciones de productividad.</value>
  </data>
  <data name="Feature_DisableStoreUpdates.Header" xml:space="preserve">
    <value>Desactivar Actualizaciones de la Tienda</value>
  </data>
  <data name="Feature_DisableStoreUpdates.Description" xml:space="preserve">
    <value>Desactiva las actualizaciones automáticas para las aplicaciones descargadas desde la Microsoft Store. Puede dejar las aplicaciones vulnerables a riesgos de seguridad o sin nuevas características.</value>
  </data>
  <data name="Privacy_Telemetry.Text" xml:space="preserve">
    <value>Telemetría</value>
  </data>
  <data name="Feature_EnhancePrivacy.Header" xml:space="preserve">
    <value>Mejorar Privacidad</value>
  </data>
  <data name="Feature_DisableSMBv1.Header" xml:space="preserve">
    <value>Desactivar SMBv1</value>
  </data>
  <data name="Feature_DisableSMBv1.Description" xml:space="preserve">
    <value>Desactiva Server Message Block versión 1 (SMBv1) para mayor seguridad. Recomendado.</value>
  </data>
  <data name="Feature_DisableSMBv2.Header" xml:space="preserve">
    <value>Desactivar SMBv2</value>
  </data>
  <data name="Feature_DisableSMBv2.Description" xml:space="preserve">
    <value>Desactiva Server Message Block versión 2 (SMBv2) para mayor seguridad. Úsalo con precaución, ya que podría romper las funciones de compartir archivos en red.</value>
  </data>
  <data name="Feature_DisableTelemetryServices.Header" xml:space="preserve">
    <value>Desactivar Servicios de Telemetría</value>
  </data>
  <data name="Feature_DisableTelemetryServices.Description" xml:space="preserve">
    <value>Desactiva los servicios de telemetría para evitar la recopilación y transmisión de datos de uso por parte del sistema operativo.</value>
  </data>
  <data name="Feature_DisableEdgeTelemetry.Header" xml:space="preserve">
    <value>Desactivar Telemetría de Edge</value>
  </data>
  <data name="Feature_DisableEdgeTelemetry.Description" xml:space="preserve">
    <value>Desactiva la recopilación de datos de telemetría en Microsoft Edge.</value>
  </data>
  <data name="Feature_DisableVisualStudioTelemetry.Header" xml:space="preserve">
    <value>Desactivar Telemetría de Visual Studio</value>
  </data>
  <data name="Feature_DisableVisualStudioTelemetry.Description" xml:space="preserve">
    <value>Desactiva la recopilación de datos de telemetría en Visual Studio.</value>
  </data>
  <data name="Feature_DisableNvidiaTelemetry.Header" xml:space="preserve">
    <value>Desactivar Telemetría de Nvidia</value>
  </data>
  <data name="Feature_DisableNvidiaTelemetry.Description" xml:space="preserve">
    <value>Desactiva la recopilación de datos de telemetría por los controladores de Nvidia.</value>
  </data>
  <data name="Feature_DisableChromeTelemetry.Header" xml:space="preserve">
    <value>Desactivar Telemetría de Chrome</value>
  </data>
  <data name="Feature_DisableChromeTelemetry.Description" xml:space="preserve">
    <value>Desactiva la recopilación de datos de telemetría en Google Chrome.</value>
