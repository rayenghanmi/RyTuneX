  </data>
  <data name="Feature_DisableLockScreenNotifications.Description" xml:space="preserve">
    <value>Ngăn thông báo biểu ngữ xuất hiện trên màn hình khóa để tăng cường quyền riêng tư và giảm sự phân tâm.</value>
  </data>
  <data name="Feature_DisableToastNotifications.Header" xml:space="preserve">
