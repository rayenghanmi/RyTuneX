    <value>Phân bổ thêm bộ nhớ hệ thống cho bộ nhớ đệm hệ thống tệp, cải thiện hiệu suất đọc ổ đĩa cho các tác vụ tệp nặng.</value>
  </data>
  <data name="Feature_DisableNDU.Header" xml:space="preserve">
    <value>Tắt theo dõi sử dụng dữ liệu mạng (NDU)</value>
  </data>
  <data name="Feature_DisableNDU.Description" xml:space="preserve">
    <value>Tắt dịch vụ NDU vốn được biết đến là nguyên nhân gây rò rỉ bộ nhớ non-paged pool trên một số hệ thống sau thời gian dài hoạt động.</value>
  </data>
  <data name="Feature_DisablePageFileEncryption.Header" xml:space="preserve">
    <value>Tắt mã hóa tệp hoán đổi (Pagefile)</value>
  </data>
  <data name="Feature_DisablePageFileEncryption.Description" xml:space="preserve">
    <value>Tắt mã hóa tệp hoán đổi của Windows để giảm tải CPU trong các hoạt động hoán đổi bộ nhớ.</value>
  </data>
  <data name="FeaturesPage_NotificationControls.Text" xml:space="preserve">
    <value>Kiểm soát thông báo</value>
  </data>
