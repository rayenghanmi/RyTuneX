  <data name="Feature_ServiceHostSplitting.Header" xml:space="preserve">
    <value>Vô hiệu hoá Service Host Splitting</value>
  </data>
  <data name="Feature_ServiceHostSplitting.Description" xml:space="preserve">
    <value>Vô hiệu hoá Service Host splitting để giảm RAM sử dụng và tiến trình.</value>
  </data>
  <data name="Feature_LegacyBootMenu.Header" xml:space="preserve">
    <value>Bật Legacy Boot Menu</value>
  </data>
  <data name="Feature_LegacyBootMenu.Description" xml:space="preserve">
    <value>Sử dụng boot menu cổ điển để khởi động nhanh hơn.</value>
  </data>
  <data name="Feature_OptimizeNTFS.Header" xml:space="preserve">
    <value>Tối ưu cài đặt NTFS</value>
  </data>
  <data name="Feature_OptimizeNTFS.Description" xml:space="preserve">
    <value>Tối ưu cài đặt NTFS để cải thiện hiệu suất và tăng cường bảo mật.</value>
  </data>
  <data name="Feature_PrioritizeForegroundApplications.Header" xml:space="preserve">
    <value>Tối ưu hiệu suất ứng dụng đang hoạt động</value>
