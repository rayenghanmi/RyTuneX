  </data>
  <data name="RepairPage_EventViewer.Header" xml:space="preserve">
    <value>Event Viewer</value>
  </data>
  <data name="RepairPage_EventViewer.Description" xml:space="preserve">
    <value>Điều này sẽ hiển thị nhật kí sự kiện gần đây của hệ thống để xử lý sự cố</value>
  </data>
  <data name="RepairPage_RepairOptions.Text" xml:space="preserve">
