  </data>
  <data name="Network_OpenNetworkSettings.Description" xml:space="preserve">
    <value>Opens the Windows Network &amp; Internet settings page.</value>
  </data>
  <data name="Network_OpenNetworkSettings_Button.Content" xml:space="preserve">
    <value>Open Settings</value>
  </data>
  <data name="Network_OpenAdapterSettings.Header" xml:space="preserve">
    <value>Network Adapter Settings</value>
  </data>
  <data name="Network_OpenAdapterSettings.Description" xml:space="preserve">
    <value>Opens the classic Network Connections panel to manage network adapters.</value>
  </data>
  <data name="Network_OpenAdapterSettings_Button.Content" xml:space="preserve">
    <value>Open Adapter Settings</value>
  </data>
  <data name="Network_DisableThrottling.Header" xml:space="preserve">
    <value>Disable Network Throttling</value>
  </data>
  <data name="Network_DisableThrottling.Description" xml:space="preserve">
    <value>Removes the 10 packets/ms throttle that Windows applies to network traffic when multimedia applications are running, improving throughput.</value>
  </data>
  <data name="Network_DisableNagle.Header" xml:space="preserve">
    <value>Disable Nagle&apos;s Algorithm</value>
  </data>
  <data name="Network_DisableNagle.Description" xml:space="preserve">
    <value>Reduces latency in TCP connections by sending packets immediately instead of buffering small ones. Beneficial for gaming and real-time applications.</value>
  </data>
  <data name="Network_EnableRSS.Header" xml:space="preserve">
    <value>Enable Receive-Side Scaling (RSS)</value>
  </data>
  <data name="Network_EnableRSS.Description" xml:space="preserve">
    <value>Distributes network receive processing across multiple CPU cores, improving throughput and reducing latency on multi-core systems.</value>
  </data>
  <data name="Network_EnableECN.Header" xml:space="preserve">
    <value>Enable ECN (Explicit Congestion Notification)</value>
  </data>
  <data name="Network_EnableECN.Description" xml:space="preserve">
    <value>Allows routers to signal network congestion without dropping packets, reducing retransmissions and improving throughput.</value>
  </data>
  <data name="Network_EnableCTCP.Header" xml:space="preserve">
    <value>Enable Compound TCP (CTCP)</value>
  </data>
  <data name="Network_EnableCTCP.Description" xml:space="preserve">
    <value>Uses a more aggressive congestion algorithm that increases throughput on high-bandwidth, high-latency connections.</value>
  </data>
  <data name="Network_DisableIPv6.Header" xml:space="preserve">
    <value>Disable IPv6</value>
  </data>
  <data name="Network_DisableIPv6.Description" xml:space="preserve">
    <value>Disables the IPv6 protocol stack. Only recommended if you are troubleshooting IPv6-related issues. A restart may be required.</value>
  </data>
