  </data>
  <data name="Feature_DisableNotificationCenter.Description" xml:space="preserve">
    <value>Removes the Notification Center (Action Center) from the taskbar. Requires Explorer restart.</value>
  </data>
  <data name="Feature_DisableSuggestedActions.Header" xml:space="preserve">
    <value>Disable Suggested Actions</value>
  </data>
  <data name="Feature_DisableSuggestedActions.Description" xml:space="preserve">
    <value>Disables the smart clipboard suggested actions flyout that appears when copying dates, phone numbers, or addresses.</value>
  </data>
  <data name="FeaturesPage_ContextMenu.Text" xml:space="preserve">
    <value>Context Menu Customization</value>
  </data>
  <data name="Feature_AddTakeOwnership.Header" xml:space="preserve">
    <value>Add "Take Ownership" to Context Menu</value>
  </data>
  <data name="Feature_AddTakeOwnership.Description" xml:space="preserve">
    <value>Adds a "Take Ownership" option to the right-click context menu for files and folders, allowing quick ownership transfer.</value>
  </data>
  <data name="Feature_AddOpenCmdHere.Header" xml:space="preserve">
    <value>Add "Open Command Prompt Here"</value>
  </data>
  <data name="Feature_AddOpenCmdHere.Description" xml:space="preserve">
    <value>Adds an "Open Command Prompt Here" option to the folder background right-click context menu.</value>
  </data>
  <data name="Feature_AddCopyFilePath.Header" xml:space="preserve">
    <value>Add "Copy File Path" to Context Menu</value>
  </data>
  <data name="Feature_AddCopyFilePath.Description" xml:space="preserve">
    <value>Adds a "Copy File Path" option to the right-click context menu for quick path copying to clipboard.</value>
  </data>
  <data name="PrivacyPage_PrivacyHardening.Text" xml:space="preserve">
    <value>Privacy Hardening</value>
  </data>
  <data name="Feature_DisableWiFiSense.Header" xml:space="preserve">
    <value>Disable Wi-Fi Sense</value>
  </data>
  <data name="Feature_DisableWiFiSense.Description" xml:space="preserve">
    <value>Disables automatic connection to suggested open Wi-Fi hotspots and shared networks from contacts.</value>
  </data>
  <data name="Feature_DisableWebSearchResults.Header" xml:space="preserve">
    <value>Disable Web Results in Search</value>
  </data>
  <data name="Feature_DisableWebSearchResults.Description" xml:space="preserve">
    <value>Prevents Windows Search from sending queries to Bing and displaying web results. Keeps search local and private.</value>
  </data>
  <data name="Feature_DisableAppLaunchTracking.Header" xml:space="preserve">
    <value>Disable App Launch Tracking</value>
  </data>
  <data name="Feature_DisableAppLaunchTracking.Description" xml:space="preserve">
    <value>Stops Windows from tracking which apps you launch for personalization of the Start menu's Most Used list.</value>
  </data>
  <data name="Feature_DisableTimelineHistory.Header" xml:space="preserve">
    <value>Disable Timeline &amp; Activity History</value>
  </data>
  <data name="Feature_DisableTimelineHistory.Description" xml:space="preserve">
    <value>Disables Windows Timeline activity feed and prevents activity data from being published or uploaded to the cloud.</value>
  </data>
  <data name="Network_DisableP2PDelivery.Header" xml:space="preserve">
    <value>Disable P2P Update Delivery</value>
  </data>
  <data name="Network_DisableP2PDelivery.Description" xml:space="preserve">
    <value>Disables peer-to-peer delivery of Windows Updates, preventing your PC from sharing update data with other PCs on the internet.</value>
  </data>
  <data name="Network_DisableHotspot20.Header" xml:space="preserve">
    <value>Disable Hotspot 2.0</value>
  </data>
  <data name="Network_DisableHotspot20.Description" xml:space="preserve">
    <value>Disables Hotspot 2.0 (Passpoint) automatic Wi-Fi hotspot discovery and connection for improved privacy.</value>
  </data>
  <data name="Network_DisableNetBIOS.Header" xml:space="preserve">
    <value>Disable NetBIOS over TCP/IP</value>
  </data>
  <data name="Network_DisableNetBIOS.Description" xml:space="preserve">
    <value>Disables legacy NetBIOS name resolution over TCP/IP to reduce network attack surface and improve security.</value>
  </data>
